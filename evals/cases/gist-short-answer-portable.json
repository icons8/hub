{
 "id": "gist-short-answer-portable",
 "title": "A short answer to the owner: no gist needed — does not call hub gist",
 "note": "Guards a part of the core's gist addendum: a short result and a turn without other tools — no gist (an extra step costs).",
 "real": [
  "maps"
 ],
