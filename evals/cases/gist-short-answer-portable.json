   "data": {
    "cwd": "$work/hub",
    "session_id": "6f1c2a10-0000-4000-8000-000000000006",
    "kind": "hub",
    "channel": "web",
    "owner": true
   }
  },
  {
   "type": "owner.seen",
   "entity": "hub",
   "data": {
    "seq": 1,
    "channel": "web",
    "owner": true
   }
  },
  {
   "type": "session.requested",
   "entity": "maps",
   "data": {
    "cwd": "$work/maps",
    "session_id": "6f1c2a10-0000-4000-8000-000000000007",
    "about": "Maps and their checks",
    "channel": "web",
    "owner": true
   }
  }
 ],
 "config": {
  "hub": {
   "enabled": true,
   "name": "hub"
  },
  "timezone": "Europe/Paris",
  "model": "opus",
  "effort": "medium"
 },
 "inject": [
  {
   "type": "message.received",
   "data": {
    "to": "maps",
    "text": "What is 17 times 23? Answer with a single number.",
    "channel": "web",
    "owner": true
   }
  }
 ],
 "checks": [
  {
   "id": "no_gist",
   "type": "no_event",
   "text": "no hub gist",
