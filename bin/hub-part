#!/usr/bin/env python3
"""hub-part <slot> [args…]: the main of a slot's code (core/embed.py) wherever that code lies — in the core's own
folders or in an embed: the parts of hub-up a slot runs (core/embed.PARTS: the accounts gateway, conduit, the stats
report; an empty command line is the part's own) and the children that code starts of itself (the stats report's child,
conduit's token, the cloud row of the voice). The core's root is this file's, so the slot's code never looks for it
from its own place."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
import platforms  # noqa: E402
platforms.current.utf8_mode([os.path.realpath(__file__)] + sys.argv[1:])   # output and files are UTF-8 under any locale
from core import embed  # noqa: E402

slots = embed.MAINS
if len(sys.argv) < 2 or sys.argv[1] not in slots:
    sys.exit(f"hub-part: one of {', '.join(slots)}")
slot = sys.argv[1]
if not embed.present(slot):
    sys.exit(f"hub-part: the code of {slot} is not in this tree")
import importlib  # noqa: E402
main = importlib.import_module(embed.SLOTS[slot]["module"]).main
default = next((args for part, (s, args) in embed.PARTS.items() if s == slot), [])   # a part's empty command line
sys.exit(main(sys.argv[2:] or default))
