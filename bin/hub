                where += " · " + coretext.human(minihub.wake_kind(run["wake"].get("about")))
            print(i18n.t("cli.task.queue_row", name=f"{name:<22}",
                         by=f"{run.get('by') or i18n.t('cli.task.queue_by_owner'):<14}", where=where, task=run['task'][:100]))
        if not runs:
            print(i18n.t("cli.task.queue_empty_line"))
    elif cmd == "task" and rest[:1] in (["show"], ["note"], ["head"]):
        # the task record (owner decision 2026-10-04: all present may write and read it, with overwrite control)
        from core import taskrec
        st, args = current(), rest[1:]
        full = rest[0] == "show" and "--full" in args
        if full:
            args = [a for a in args if a != "--full"]
