            sys.exit(i18n.t("cli.task.no_tasks", name=ME))
        if not did:
            sys.exit(i18n.t("cli.task.unknown"))
        if note and not ref and len(taskrec.open_of(st, ME)) > 1:   # no number and several open: it would guess
            sys.exit(i18n.t("cli.task.note_which", name=ME, tasks="\n".join(
                f"  {d['id']}  {' '.join(taskrec.brief(d).split())[:80]}" for d in taskrec.open_of(st, ME))))
        closed = taskrec.closed(st, did)
        if rest[0] != "show" and not taskrec.may_write(st, did, ME, outsider=bool(OUTSIDER)):
            sys.exit(i18n.t("cli.task.closed_foreign", did=did, name=st["delegations"][did]["session"]))
        if note and closed and not ref:   # no open one of its own: the latest, closed one was taken, so say which
            print(i18n.t("cli.task.latest_closed", did=did))
        if rest[0] == "show":
            text = taskrec.read(STATE, st, did)
