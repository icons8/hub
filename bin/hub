        sub, words = rest[0], rest[1:]
        grep, words = value_of(words, "--grep")
        count, words = value_of(words, "-n")
        spec, words = value_of(words, "--from")
        cut, words = value_of(words, "--evicted")
        check = "--check" in words
        words = [w for w in words if w != "--check"]
        sessions = current()["sessions"]

        def folder_of(name):
            s = sessions.get(name or "")
            prof = reducer.profile_of(s) or (s or {}).get("profile")   # an executor reads its raiser's profile
            if not prof or s["state"] == "removed":
                sys.exit(i18n.t("cli.profile.no_agent", name=name or "—"))
            return os.path.join(STATE, "agents", str(prof))
        if sub == "evicted":
            name = words[0] if words else ME
            if not name or len(words) > 1 or (count is not None and not count.isdigit()):
                sys.exit("hub profile evicted [<agent>] [--grep <topic>] [-n N]")
            shown, total = profcap.search(folder_of(name), grep, int(count) if count is not None else 20)
            if not total:
                print(i18n.t("cli.profile.none_grep" if grep else "cli.profile.none", name=name, topic=grep or ""))
            for e in shown:
                print(f"## {e['id']} \u00b7 {e['when']} \u00b7 {e['section']}\n{e['text']}\n")
            if total > len(shown):
                print(i18n.t("cli.profile.more", n=total - len(shown)))
        elif sub == "restore":
            if len(words) not in (1, 2) or not (ME or len(words) == 2):
                sys.exit("hub profile restore <id> [<agent>]")
            name = words[1] if len(words) == 2 else ME
            found = profcap.entries(profcap._read(os.path.join(folder_of(name), profcap.EVICTED)) or "")
            if words[0] not in {e["id"] for e in found}:
                sys.exit(i18n.t("cli.profile.no_id", id=words[0], name=name))
            put("profile.restore_requested", name, {"id": words[0]})
        else:
            if len(words) != 1 or not spec:
                sys.exit("hub profile pin <agent> --from <pinned.md> [--evicted <cut.md>] [--check]")
            folder = folder_of(words[0])
            spec, cut = os.path.abspath(spec), os.path.abspath(cut) if cut else None
            if not spec.endswith(".md") or (cut and not cut.endswith(".md")):
                sys.exit(i18n.t("cli.profile.unreadable"))
            text = profcap._read(os.path.join(folder, profcap.AGENT))
            listed = profcap._read(spec)
            if text is None or listed is None or (cut and profcap._read(cut) is None):
                sys.exit(i18n.t("cli.profile.unreadable"))
            marks, problems = profcap.pin_plan(text, listed)
            for line in problems:
                print("  " + line)
            print(i18n.t("cli.profile.plan", n=len(marks), bad=len(problems)))
            if problems:
                sys.exit(1)
            if not check:
                put("profile.pin_requested", words[0], {"spec": spec, "cut": cut})
    elif cmd == "show" and rest:
        # what a session did and wrote, from the core journal (owner request 2026-09-30)
        # the parsed data is kept next to the journal and only new data is read (07.10: 10.7 s); no session: by the state file
        from core import i18n, tail, views
        full = "--full" in rest
        rest = [w for w in rest if w != "--full"]
        grep, rest = value_of(rest, "--grep")   # in any place; with a session — a search inside it
        n, rest = value_of(rest, "-n")
        n = positive(n, "-n", int) if n is not None else None
        if grep is not None and len(rest) > 1 or not rest and grep is None:
            sys.exit(misuse())
        ref = bool(rest) and grep is None and views.REF.fullmatch(rest[0])   # mN, qN, dN: a journal record; a session with that name wins
        if rest and not ref and not tail.known(STATE, rest[0]):
            print(i18n.t("cli.no_session", name=rest[0]))
            return
        reader = tail.cached(STATE, full=grep is not None)
        if grep is not None:
            from core import history
            names = history.names(reader.state, rest[0]) if rest else None
            # the reader holds every row of the journal file (not the page's last 400 per session); older ones come from the parsed journal archives (the page's "Show earlier")
            renamed = {k[4:]: v for k, v in (reader.state.get("aliases") or {}).items()
                       if k.startswith("was:") and k[4:] not in reader.state.get("sessions", {})}   # a former name — the current one
            older, info = history.grep(STATE, grep, names, n or 30, reader.timelines, renamed=renamed)
            lines = views.grep(reader, grep, n=n or 30, full=full, only=names, older=older)
            partial = info["unparsed"] or info["stopped"]   # a part of the archives was not searched: no row is not "nobody"
            print("\n".join(lines) if lines else i18n.t("cli.show.grep_none_here" if partial else "cli.show.grep_nobody", text=grep))
            if info["unparsed"]:
                print(i18n.t("cli.show.grep_unparsed", n=info["unparsed"]))
            if info["stopped"]:
                print(i18n.t("cli.show.grep_stopped", seconds=history.GREP_BUDGET, seq=journal.archive_last(info["stopped"])))
        else:
            # hub show does not stitch the feed from before the journal rotation: its reader starts at the last snapshot,
            # and lines between the archive and the window would drop out silently (review 13.10); earlier ones are "Show earlier" on the page
            lines = (tail.known(STATE, rest[0]) or not ref) and views.show(reader, rest[0], n=n or 20, full=full)
            if not lines and ref:
                lines = views.entry(STATE, rest[0], reader)
                if not lines:
                    sys.exit(i18n.t("cli.show.no_entry", ref=rest[0]))
            print("\n".join(lines) if lines else i18n.t("cli.no_session", name=rest[0]))
    elif cmd == "attach" and len(rest) == 1:
        os.execvp("tmux", ["tmux", "-L", "hub", "attach", "-t", "=hub-" + rest[0]])
    elif cmd == "setup" and rest[:1] == ["claude"]:   # the release's Claude Code into the hub's folder (core/ownclaude.py)
        from core import i18n
        if ME or OUTSIDER:   # the program every session of the hub runs: the owner's terminal only
            sys.exit(i18n.t("cli.claude_setup.owner_only"))
        sys.exit(_ownclaude.main(rest[1:], STATE))
    elif cmd == "setup" and rest[:1] == ["codex"]:   # Codex CLI from OpenAI's releases (core/codexinstall.py)
        from core import codexinstall, i18n
        if ME or OUTSIDER:   # it puts codex into the user's ~/.local/bin for every session: the owner's terminal only
            sys.exit(i18n.t("cli.claude_setup.owner_only"))
        sys.exit(codexinstall.main(rest[1:], STATE))
    elif cmd == "setup" and rest[:1] == ["voice"]:   # the built-in voice: download the model or remove it (modules/voice)
        from core import i18n
        if OUTSIDER or ME and (current()["sessions"].get(ME) or {}).get("kind") != "hub":
            sys.exit(i18n.t("cli.setup.voice_owner_only"))
        from modules.setup import setup
        sys.exit(setup.voice_cli(STATE, rest[1:]))
    elif cmd == "setup" and not rest:   # what is left before the hub works (modules/setup, the page's «Setup»)
        from modules.setup import setup
        sys.exit(setup.cli(STATE, claude_command()))
    elif cmd == "export":   # the hub into one archive, for a backup or another machine (core/hubexport.py)
        from core import catalog, hubexport
        # what it takes without --secrets every session reads from the disk anyway; the secrets under a password a
        # session chose — no
        if "--secrets" in rest and (ME or OUTSIDER):
            sys.exit(i18n.t("cli.export.secrets_terminal"))
        sys.exit(hubexport.main_export(rest, STATE, catalog.config_dir()))
    elif cmd == "import":   # a hub from its archive onto this machine (core/hubexport.py)
        from core import catalog, hubexport
        if ME or OUTSIDER:   # it stops the hub: from a session it would stop itself mid-way
            sys.exit(i18n.t("cli.import.owner_only"))
        sys.exit(hubexport.main_import(rest, STATE, catalog.config_dir(), stop=import_stop, start=import_start))
    elif cmd == "support-bundle":   # a zip for support, masked, sent nowhere (core/supportbundle.py)
        from core import i18n, supportbundle
        if ME or OUTSIDER:
            sys.exit(i18n.t("cli.bundle.owner_only"))
        sys.exit(supportbundle.main(rest, STATE))
    elif cmd == "uninstall":   # take the hub off the machine; the data only with --purge (core/uninstall.py)
        from core import catalog, i18n, uninstall
        if ME or OUTSIDER:
            sys.exit(i18n.t("cli.uninstall.owner_only"))
        sys.exit(uninstall.main(rest, STATE, catalog.config_dir(), platforms.current.service_unit(STATE)))
    elif cmd == "instance":   # several hubs on this machine (core/instancecli.py): new and uninstall — the owner's terminal
        from core import i18n, instancecli
        if rest[:1] != ["list"] and (ME or OUTSIDER):   # a new service on the machine: never a session's step
            sys.exit(i18n.t("cli.instance.owner_only"))
        sys.exit(instancecli.main(rest))
    elif cmd == "app":   # the move from a git clone into the app and back (core/appmove.py): the installer's, the owner's
        # the core's working copy (hub app src): the Hub Developer's step too, it edits the core there
        dev = (_catalog.load_config(STATE).get("dev") or {}).get("name") or "hub-dev"
        if OUTSIDER or ME and not (rest[:1] in (["src"], ["apply"]) and ME == dev):
            sys.exit(i18n.t("cli.app.owner_only"))
        sys.exit(app_cmd(rest))
    elif cmd == "doctor" and not rest:   # is the hub ready; core modules and their checks (core/modcli.py)
        from core import claudeauth, modcli
        unit = platforms.current.service_unit(STATE)
        rows = modcli.checks(STATE, claude_command(), ports={   # this hub's ports: a second hub has its own
            "web": web_port(unit), "files": files_port(unit)},
            login=lambda claude, env: claudeauth.status(claude, env=env, timeout=20))
        print(modcli.report(rows))
        sys.exit(1 if any(level == "fail" for level, _, _ in rows) else 0)
    else:
        from core import modcli   # a core module command (module.json: commands), or help
        if (cmd, rest[:1]) == ("accounts", ["use"]):
            # no built-in pool in the tree: a switch by the owner's or the hub's word is still the core's (core/profiles.py)
            from core import catalog, profiles
            code = profiles.cli_use(rest, current(), put, ME or OUTSIDER, catalog.config_path(STATE), state_dir=STATE)
            if code is not None:
                sys.exit(code)
        code = modcli.run(STATE, cmd, rest, modcli.caller(ME), core=core_commands())
        if code is None and cmd in CUT_MODULES:   # cut out of this tree: whose command it is, not the whole help
            from core import i18n
            sys.exit(i18n.t("cli.module_command", cmd=cmd, module=CUT_MODULES[cmd]))
        if code is None and cmd not in core_commands():
            from core import i18n
            if cmd in INVENTED:   # sessions invent it: one line saying what answers, not the whole list
                sys.exit(i18n.t(INVENTED[cmd]))
            from core import clihelp   # what answers instead (a common mistake of the help, the closest command); none — the index
            hints = clihelp.load().wrong_top(cmd)
            sys.exit(i18n.t("cli.help.no_command", cmd=cmd) + "\n" + ("\n".join(hints) if hints else "\n" + usage([])))
        sys.exit(misuse() if code is None else code)


if __name__ == "__main__":
    # everything the command prints may carry text from sessions, tools and chats: without terminal control characters,
    # in errors too (sys.exit(text) and tracebacks write to sys.stderr)
    sys.stdout, sys.stderr = Printable(sys.stdout), Printable(sys.stderr)
    try:
        main(sys.argv[1:])
    except SystemExit as e:
        if REJECTED and e.code in (None, 0):   # the core refused the fact: the command did not do what it claims
            sys.exit(1)
        raise
    sys.exit(1 if REJECTED else 0)
