#!/usr/bin/env python3
"""hub — the commands of the owner and of sessions: facts into the core's mailbox, state from its journal.

The help of every command lives in core/hubhelp.txt (`hub --help`, `hub <command> --help`); core/clihelp.py renders
it, and bin/hub refuses a flag that a command's help does not name (tests/test_clihelp.py holds both to this code).
"""
import datetime
import json
import math
import os
import re
import subprocess
import sys
import time
import uuid

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
import platforms  # noqa: E402
platforms.current.nested_args()   # the Git Bash wrapper's switch is not for what this command starts
platforms.current.utf8_mode([os.path.realpath(__file__)] + sys.argv[1:])
from core import perms  # noqa: E402
perms.private()   # hub files are for its user only (core/perms.py)
from core import journal, layout, minihub, parking, reducer, restart, spool, workspace  # noqa: E402
from core.daemon import claude_command, default_state_dir  # noqa: E402

STATE = default_state_dir()
SPOOL = os.path.join(STATE, "spool")
from core import catalog as _catalog  # noqa: E402
if _catalog.OWNER_CLAUDE_DIR not in os.environ:   # from sessions and modules: the folder the hub was started with, until it restarts
    _catalog.pin_claude_dir(STATE)   # claude_config_dir: from the owner's terminal, the same Claude Code folder as the hub's
from core import ownclaude as _ownclaude  # noqa: E402
if _ownclaude.mine(STATE):   # the release's own copy: its updates off for every claude a hub command starts
    _ownclaude.switches()


# a plugin or core module process under hub-up (HUB_EXTENSION, HUB_MODULE): its word, not the owner's
OUTSIDER = os.environ.get("HUB_EXTENSION") or (f"mod:{os.environ['HUB_MODULE']}" if os.environ.get("HUB_MODULE") else None)
# a command from a hub session is the session's word, not the owner's; a plugin process is not a session, even if
# HUB_SESSION reached it from the session that started it (the core records it as a plugin anyway: core/spool.outsider)
ME = None if OUTSIDER else os.environ.get("HUB_SESSION")
SRC = "session" if ME else "cli"   # src of this command's facts in the spool (put, plugin_hooks)


REJECT_WHY = {}  # rejection reason by seq: printed after the command, from the core's answer
REJECTED = []  # core rejections in this call: the command ends with a non-zero code (bus 03.10: "accepted" does not lie)


def board_link(card, text):
    """Link of a task to a board card (modules/directions/direction.run_link): (link or None, the session's direction
    slug or None); --board from the wrong session or for the wrong card is a call error."""
    from modules.directions import direction
    slug = (current()["sessions"].get(ME) or {}).get("backlog") if ME else None
    try:
        return direction.run_link(slug, card, text), slug
    except direction.Fail as e:
        sys.exit(str(e))


def direction_repo(name):
    """The repo of the direction named so, or None: an executor run for a direction's name without --repo comes up in a
    copy of the direction's own repo, not in the raiser's folder (06.11: the hub brought a direction up in its own
    folder, not git — it worked by itself and could not become a mini-hub)."""
    from modules.directions import direction
    try:
        repo = direction.load_meta(direction.home(name)).get("repo")
    except (direction.Fail, ValueError, OSError):   # not a direction; an unreadable hub.json is not this command's to judge
        return None
    return repo if isinstance(repo, str) and os.path.isdir(repo) else None


def lead_repo(rest):
    """`hub direction new <slug>` without --repo: the git repo (with a commit) of the session that will lead it — the
    lead as the core counts it below (--session, the session itself, or for the hub and the owner the one named <slug>);
    a session in a core copy gives the repo of its copy, not the copy the core removes later. None — the direction gets
    a git folder of its own (modules/directions/direction.own_repo)."""
    from modules.directions import direction
    if "--adopt" in rest or "--session" in rest[-1:]:   # --adopt names its repo; a bare --session is the usage error
        return None
    sessions = current()["sessions"]
    boss = not ME or (sessions.get(ME) or {}).get("kind") == "hub"
    who = rest[rest.index("--session") + 1] if "--session" in rest[2:-1] else (rest[1] if boss else ME)
    return direction.repo_of(sessions.get(who))


def value_of(words, flag):
    """`<flag> VALUE` from the command words: (VALUE or None, the remaining words); a flag as the last word is a call
    error, not a word of the text and not a silent default."""
    if flag not in words:
        return None, words
    i = words.index(flag)
    if i + 1 >= len(words):
        from core import i18n
        sys.exit(i18n.t("cli.hub.needs_value", flag=flag))
    return words[i + 1], words[:i] + words[i + 2:]


def positive(text, flag, kind=float):
    """A positive finite number from an option or the environment, or a call error (not a traceback)."""
    try:
        n = kind(text)
    except (TypeError, ValueError):
        n = None
    if n is None or not math.isfinite(n) or n <= 0:
        from core import i18n
        sys.exit(i18n.t("cli.hub.needs_positive", flag=flag, text=text))
    return n


def web_port(unit=None):
    """Page port: HUB_WEB_PORT, otherwise the anchor of an instance (core/instance.py), otherwise from the OS service,
    otherwise 8787."""
    if os.environ.get("HUB_WEB_PORT"):
        return positive(os.environ["HUB_WEB_PORT"], "HUB_WEB_PORT", int)
    from core import instance
    return instance.anchored("web", STATE) or (unit or {}).get("port") or 8787


def files_port(unit=None):
    """The "Files" port: HUB_FILES_PORT, otherwise the anchor's, otherwise from the OS service, otherwise 8788."""
    files = os.environ.get("HUB_FILES_PORT", "")
    if files.isascii() and files.isdigit():
        return int(files)
    from core import instance
    return instance.anchored("files", STATE) or (unit or {}).get("files_port") or 8788


def text_words(words):
    """The text words of a command that takes a free text (hub send, task run, task note): as typed, or — when the text is
    exactly `-` (stdin) or `--file PATH` — the text read from there as one word. A text in the argument goes through the
    shell, which runs backticks and eats `$...` in it; stdin (`<<'EOF'`) and a file do not. An empty input is a call error."""
    from core import i18n
    if words == ["-"] or words == ["--file", "-"]:   # `--file -` is stdin too, not a file named "-"
        what = i18n.t("cli.text.stdin")
        try:
            raw = platforms.current.read_stdin()
        except (OSError, AttributeError):   # no stdin at all
            raw = ""
        except ValueError as e:   # not UTF-8
            sys.exit(i18n.t("cli.text.file_unreadable", path=what, why=e))
    elif words[:1] == ["--file"]:
        if len(words) != 2:
            sys.exit(i18n.t("cli.text.file_usage"))
        what = words[1]
        try:
            with open(os.path.expanduser(what), encoding="utf-8-sig") as f:
                raw = f.read()
        except (OSError, ValueError) as e:   # ValueError: not UTF-8
            sys.exit(i18n.t("cli.text.file_unreadable", path=what, why=e.strerror if isinstance(e, OSError) else e))
    else:
        return words
    if not raw.strip():
        sys.exit(i18n.t("cli.text.empty_input", what=what))
    return [re.sub(r"\A\s*\n", "", raw).rstrip()]   # the first line keeps its indentation (a diff, a YAML block)


def text_or_exit(words, usage, owner_words=False):
    """Message text: empty is a call error, not a message. From a session, module or plugin likewise text made only of
    spaces, punctuation and invisible characters ("—", "..."): a "—" reply used to wake the addressee, who answered
    the same: a loop of silent replies. A letter, digit, emoji or any other symbol ("+", "✓") is already a message. The
    owner from the terminal and the owner's words passed on (owner_words, --for; the core checks that they are the
    owner's) are taken as is: their "?" is a question."""
    import unicodedata
    from core import i18n
    text = " ".join(text_words(words))
    if not text.strip():
        sys.exit(i18n.t("cli.send.empty", usage=usage))
    if (ME or OUTSIDER) and not owner_words and all(
            unicodedata.category(c)[0] in "PZ" or unicodedata.category(c) in ("Cc", "Cf") for c in text):
        sys.exit(i18n.t("cli.send.no_letters", usage=usage))
    return text


def own_rework(st, name):
    """For a mini-hub: the one task it gave executor name that it handed in, while it sleeps after the hand-in — its
    id, or None (another session, a direction — the hub or the owner wakes those — not asleep, none or several: the
    core's refusal names them). What `--about dN` would name: 13.11, 19 refusals in a week asked a mini-hub for the
    task the core already knew."""
    from core import delegations, executors, identity
    name = identity.resolve(st, name) or name
    sleeper = st["sessions"].get(name) or {}
    if not ME or sleeper.get("raised_by") != ME or sleeper.get("backlog") or not executors.dormant(sleeper) \
            or not minihub.on(st, st["sessions"].get(ME)):
        return None
    mine = delegations.done_for(st, name, ME)
    return mine[0]["id"] if len(mine) == 1 else None


def queued_note(name, seq):
    """After a wake with a job: no free slots — the rework waits in the core's queue; say where it is."""
    from core import i18n
    run = (current().get("runs") or {}).get(name) if seq and seq not in REJECTED else None
    if run and run.get("wake") and run.get("state") == "queued":
        from core import coretext, executors   # the core's phrases: in the language of whoever reads
        print(i18n.t("cli.session.wake_queued", pos=executors.position(current(), name),
                     kind=coretext.human(minihub.wake_kind(run['wake'].get('about'), acc=True)),
                     why=coretext.human(coretext.got(run, "why")), name=name))


def routed_task(st, ref):
    """The task of `hub route <dN|mN> executor`: dN itself or the task the message mN carries — as the core's _route."""
    d = st["delegations"].get(ref)
    return d or st["delegations"].get((st["messages"].get(ref) or {}).get("delegation") or "")


def pin_flags(words, need=False, task=None):
    """Executor model and effort from the command words: (data, remaining words). A session names the kind of work,
    `--work normal|risky`, and the pair is taken from "Settings -> General -> Advanced -> Executors" (owner decision
    2026-10-13), or is the agent's own one (`executors.agents.<agent>`), which replaces the kind; `--model M --effort E`
    is an explicit pair (owner from the terminal) and wins over the kind. need: a session raises an executor: without
    a kind (and without a pair on the task dN) it is refused with the rule and nothing goes to the core. task: a
    lambda giving the task when the executor is routed to it (`hub route dN|mN`, made by the hub or the owner; mN — the
    task the message carries, routed_task): the own pair is then the one of the task's agent, not of whoever routes."""
    from core import catalog, modelrule
    pin, work = {}, None
    for flag in ("--work", "--model", "--effort"):
        value, words = value_of(words, flag)
        if value is None:
            continue
        if flag == "--work":
            work = value
        else:
            pin[flag[2:]] = codex_model(value) if flag == "--model" else value
    routed, load = callable(task), task
    task = None if routed else task
    if work is not None or need:
        try:
            cfg = catalog.load_config(STATE)
        except ValueError:   # broken hub.json: default pairs, not a traceback (review 13.10)
            cfg = {}
        # the state is read only when it decides something: the task of a route without --work, or an own pair is set
        pairs = need and modelrule.any_pairs(cfg)
        task = load() if routed and (work is None or pairs) else task
        # whose pair: the agent of the routed task; for hub task run the agent whose executor it is (the lead of ME's
        # chain; the owner's — the hub's), not ME itself
        raiser = (task or {}).get("session") if routed else modelrule.agent_of(current(), ME) if pairs else ME
        mine = modelrule.own(raiser, cfg) if pairs else None   # the agent's own pair outranks the kind and the task's pair
        by_work = modelrule.pin(work, cfg, mine, task)
        if by_work is None and (work is not None or ME):
            from core import i18n
            sys.exit((i18n.t("cli.task.work_unknown", work=repr(work)) if work else i18n.t("cli.task.work_none")) +
                     i18n.t("cli.task.work_repeat") + "\n" + pin_rule())
        # limit-saving pair (core/budget.py): normal without an explicit pair uses it if raised in economy mode; what an
        # agent's own pair (executors.agents) sets is its choice and is not lowered, the rest is. A route names no
        # --work: the kind is the one the task already has, and so is its saving (a task raised with a pair of its own
        # has none: that pair is not lowered)
        kind = work if work is not None else (task or {}).get("work")
        saved = work is not None or (task or {}).get("economy")
        eco = modelrule.economy(cfg, mine) if kind == "normal" and saved and not pin else None
        pin = {**(by_work or {}), **pin, **({"work": kind} if kind else {}), **({"economy": eco} if eco else {})}
    return pin, words


def codex_model(model):
    """A model typed for a session or an executor, in the form the hub's engine takes (core/modelrule.codex_name: on a
    Codex hub a bare listed id becomes codex/<id>); an unknown one ends the command with the form and real ids."""
    from core import catalog, modelrule
    try:
        cfg = catalog.load_config(STATE)
    except ValueError:   # broken hub.json: as typed, the core decides
        return model
    # a hub with Claude's sessions next to Codex's knows it by the core's mark (HUB_CODEX=1 may be only in the
    # service's environment, not this terminal's); a Claude name needs no look
    host = catalog.codex_host(cfg) or model not in ("", "default") and not catalog.known_model(model) and \
        catalog.codex_state(current())
    model, why = modelrule.codex_name(model, cfg, STATE, host=bool(host))
    if why:
        sys.exit(why)
    return model


def pin_rule():
    """The rule: which kind of work when, with pairs from the hub settings (core/modelrule.py, "Settings -> General -> Advanced -> Executors")."""
    from core import catalog, modelrule
    try:
        cfg = catalog.load_config(STATE)
    except ValueError:   # broken hub.json: help is still needed, default pairs (review 13.10)
        cfg = {}
    return modelrule.rule(cfg, width=80)


ARGV = []   # the words of this call: usage() is the help of this command, not of all of them


def usage(words=None):
    """Help (core/hubhelp.txt): of the command the words name (by default this call's), with the model rule of this
    hub's settings under `task run`; a core module's command — its line; otherwise the index, module commands last."""
    from core import clihelp, modcli
    words = ARGV if words is None else words
    help_ = clihelp.load()
    text = help_.render(words, rule=pin_rule) if words else None
    if text is None:
        core = core_commands()
        mods = [(c, o[0][0], o[0][1]) for c, o in sorted(modcli.commands(STATE).items()) if c not in core]
        mine = [m for m in mods if words and m[0] == words[0]]
        from core import codexmodel
        hide = () if codexmodel.on_codex(STATE) else ("codex",)   # EXPERIMENT: a hub without Codex sees main's index
        text = help_.labels["module"].format(module=mine[0][1], about=mine[0][2]) if mine else help_.index(mods, hide)
    return text.rstrip("\n")


def misuse(words=None):
    """The refusal of words no branch of a command took (by default this call's): the subcommand it does not know and
    the closest ones, or that the words do not fit the form; then the form, an example and where the help is (13.11: a
    guessed subcommand — `tools requests`, `wait list` — got the help with no word of what was wrong). A command
    the help does not describe (a core module's) — its help, as before."""
    from core import clihelp, i18n
    words = ARGV if words is None else words
    help_ = clihelp.load()
    if not words or words[0] not in help_.tops():
        return usage(words)
    top, rest = words[0], words[1:]
    word = help_.misfit(top, rest)
    entry = help_.entry(top, rest)
    head = i18n.t("cli.help.no_subcommand", cmd=top, word=word, subs=", ".join(help_.subcommands(top))) if word else \
        i18n.t("cli.help.no_form", cmd=entry.key if entry else top)
    return head + "\n" + help_.advice(top, rest, word, unknown=bool(word))


def cutout_present(name):
    from core import cutout
    return cutout.present(name)


# names sessions use as commands that do not exist -> the key of the one line the refusal gives (not `cmd == "…"`:
# core_commands() reads those comparisons from this file as the names of commands)
INVENTED = {"reply": "cli.help.no_reply"}


def core_commands():
    """Names of core commands: a module will not get them even if it declares them (core/modcli.py)."""
    from core import clihelp
    try:
        with open(os.path.realpath(__file__), encoding="utf-8") as f:
            src = f.read()
    except (OSError, UnicodeDecodeError):   # built hub (package): no source, so the help names them
        src = ""
    from core import cutout
    cut = {c for c, f in CUT_COMMANDS.items() if not cutout.present(f)}   # the open flavor: a module may take them
    return (set(re.findall(r'cmd == "([a-z-]+)"', src)) | clihelp.load().tops()) - cut


# commands whose code the open flavor cuts out of the tree (core/cutout.py) -> its function: without it `hub accounts use`
# stays the core's (core/profiles.cli_use), the rest is a login or stats module's command, or one line whose it is
CUT_COMMANDS = {"accounts": "profile", "conduit": "conduit", "stats": "stats"}
CUT_MODULES = {"accounts": "accounts", "conduit": "accounts", "stats": "stats"}


def unknown_flags(cmd, rest):
    """A word that looks like a flag the command does not have is a call error, not a word of the text (05.11: sessions
    guessed flags — `--reply-to`, `--caption`, `-o` — and the word went into the message or failed late); the flags
    are those of the command's help (core/hubhelp.txt)."""
    from core import clihelp
    if cmd == "direction" or not any(clihelp.TYPED.fullmatch(w) for w in rest):   # a backlog reads its own words
        return
    if cmd == "run":   # after its own leading flags the words are the command (`--only after` is the command's)
        return
    help_ = clihelp.load()
    # a core module's command, or one whose help is its own parser's (`>`: accounts, bus): it reads its own words
    if cmd not in help_.tops() or any(e.own for e in help_.of_top(cmd)):
        return
    bad = help_.unknown(cmd, rest)
    if bad:
        from core import i18n
        sys.exit(i18n.t("cli.help.unknown_flag", cmd=cmd, flags=", ".join(bad),
                        known=", ".join(sorted(help_.flags(cmd, rest)[0])) or "—") + "\n" +
                 help_.advice(cmd, rest, bad[0].partition("=")[0], unknown=True, more=False))


def speaker(type, data):
    """Who speaks (channel, owner, sender) in the fact data from this command: what the spool checks (core/admit.py)."""
    data = dict(data or {})
    if ME:
        data.update(channel="session", owner=False, sender=ME)
        if os.environ.get("HUB_SCHEDULE_JOB"):   # a schedule script on behalf of a session (watchdog) is not its turn (core/chain.py)
            data["schedule_job"] = os.environ["HUB_SCHEDULE_JOB"]
    elif OUTSIDER:  # a plugin (API 1.2) or module (sender mod:<name>) process: its word, not the owner's
        data.update(channel="plugin", owner=False, sender=OUTSIDER)
    else:
        data.update(channel="cli", owner=True)
        if os.environ.get("HUB_SCHEDULE_JOB"):   # a schedule command job (modules/scheduler/clock.py)
            data["schedule_job"] = os.environ["HUB_SCHEDULE_JOB"]
            if type == "message.received":
                # its message is not the owner's words: not an answer to a card or form, it does not clear "waiting for
                # you" (20.10: a monitor closed a session's question); its other commands are as from the owner's terminal
                data["owner"] = False
    return data


def put(type, entity=None, data=None, wait=None, quiet=False, say=True):
    """Put a fact into the spool and wait until the core records it: prints the outcome, accepted or rejected with a
    reason. Without waiting the state right after the command would be stale (on 29.09 the hub saw "replied" after its
    own done). quiet: a trace fact of someone else's command (a board card edit): do not wait and print nothing."""
    from core import i18n
    data = speaker(type, data)
    data["req"] = uuid.uuid4().hex[:12]
    spool.put(SPOOL, type, entity, data, src=SRC)
    if quiet:
        return None
    what = f"{type} {entity or ''}".strip()
    wait = float(os.environ.get("HUB_CLI_WAIT", "5")) if wait is None else wait
    seq, why = journal.decided(os.path.join(STATE, "journal.jsonl"), data["req"], wait)
    if why:
        from core import coretext
        if say:   # the core's phrases: English in a session's step, the owner's language in his terminal; the logic below
            # and REJECT_WHY keep the reason as the core gave it
            print(i18n.t("cli.put.rejected", what=what, why=coretext.human(why)))
        REJECTED.append(seq)
        REJECT_WHY[seq] = why
        return seq
    if seq is not None:
        if say:
            print(i18n.t("cli.put.accepted", what=what, seq=seq))
        return seq
    print(i18n.t("cli.put.spooled", what=what))
    if ME and wait > 0:   # it waited and did not get an answer: if the core rejects later, it tells the session by message (06.10: a rejection used to get lost)
        spool.put(SPOOL, "cli.gave_up", None, {"req": data["req"], "what": what, "channel": "session", "owner": False,
                                              "sender": ME}, src="session")
        # 08.10, 14.10: the core was busy, commands completed seconds later, but sessions thought them lost and repeated them
        print(i18n.t("cli.put.not_lost"))
    return None


def busy_note(seq):
    """After hub send / hub task new: the specialist is busy, so say where it went (owner decision 2026-10-05: to a busy one, through the hub)."""
    if not seq or seq in REJECTED:
        return
    from core import i18n
    st = current()
    d = st["delegations"].get(f"d{seq}")
    msg = st["messages"].get(d["message"] if d else f"m{seq}") or {}
    who = st["sessions"].get(msg.get("session") or "") or {}
    ref = d["id"] if d else msg.get("id")
    # the bus passed it to the executor's mini-hub: the sender learns where it went (10.11: the hub got "accepted" for
    # words to a sleeping executor, took them as delivered, and they went to its mini-hub). Passing them on is the
    # mini-hub's (its note says how): a wake hint to the sender too would bring the executor the words twice
    meant = msg.get("relayed_for")
    if not d and meant and who.get("name") and meant != who["name"]:
        print(i18n.t("cli.send.passed_minihub", name=meant, got=who["name"], ref=ref))
    if msg.get("injected"):
        print(i18n.t("cli.send.busy_injected", name=who['name'], ref=ref))
    elif msg.get("held"):
        print(i18n.t("cli.send.busy_held", name=who['name'], ref=ref))
    elif msg.get("state") == "queued" and who.get("state") in ("busy", "dialog") and minihub.on(st, who):
        print(i18n.t("cli.send.busy_minihub", name=who['name'], ref=ref))
    elif d and msg.get("state") == "queued" and who.get("role") == "agent" and who.get("state") in ("busy", "dialog") \
            and (st["sessions"].get(ME or "") or {}).get("kind") == "hub":
        print(i18n.t("cli.send.busy_route", name=who['name'], ref=ref))
    elif msg.get("state") == "queued" and who.get("role") == "agent" and who.get("state") in ("busy", "dialog"):
        print(i18n.t("cli.send.busy_queued", name=who['name'], ref=ref))


UNTIL_SPAN = re.compile(r"(\d+)\s*(min|m|h)")
UNTIL_CLOCK = re.compile(r"(\d{1,2}):(\d{2})")


def run_until(text, now, tz):
    """`hub run --until`: 90m, 6h, 1h30m (a length) or 18:30 (the owner's local time, the nearest ahead) -> until_at, or
    None when it is not one of these."""
    text = text.strip().lower()
    m = UNTIL_CLOCK.fullmatch(text)
    if m:
        from zoneinfo import ZoneInfo
        try:
            zone = ZoneInfo(tz or "UTC")
        except Exception:   # noqa: BLE001 — an unknown zone (no tzdata): UTC
            zone = datetime.timezone.utc
        local = datetime.datetime.fromtimestamp(now, zone)
        if int(m.group(1)) > 23 or int(m.group(2)) > 59:
            return None
        at = local.replace(hour=int(m.group(1)), minute=int(m.group(2)), second=0, microsecond=0)
        if at.timestamp() <= now:
            at += datetime.timedelta(days=1)
        return at.timestamp()
    parts = UNTIL_SPAN.findall(text)
    if not parts or UNTIL_SPAN.sub("", text).strip():
        return None
    return now + sum(int(n) * (3600 if unit == "h" else 60) for n, unit in parts)


def run_command(rest):
    """hub run [--until <term>] [--cwd <folder>] <command…> | -; hub run list [--all]; hub run stop <runN>
    (core/hubrun.py: the core runs it outside the session, the result comes as a message)."""
    from core import hubrun, i18n
    if rest[:1] == ["list"] and set(rest[1:]) <= {"--all"}:
        return run_list("--all" in rest[1:])
    if rest[:1] == ["stop"] and len(rest) == 2:
        put("run.stop_requested", rest[1], {})
        return
    if not ME:
        sys.exit(i18n.t("cli.run.from_session"))
    now, until, cwd, words = time.time(), None, os.getcwd(), list(rest)
    st = current()
    while words[:1] and words[0].startswith("-") and words[0] != "-":
        if words[0] not in ("--until", "--cwd") or len(words) < 2:
            sys.exit(i18n.t("cli.run.usage"))
        flag, value, words = words[0], words[1], words[2:]
        if flag == "--cwd":
            cwd = os.path.abspath(os.path.expanduser(value))
            if not os.path.isdir(cwd):
                sys.exit(i18n.t("cli.run.no_cwd", cwd=cwd))
        else:
            until = run_until(value, now, st["owner"].get("tz"))
            if until is None or not hubrun.MIN_LENGTH <= round(until - now) <= hubrun.MAX_LENGTH:
                sys.exit(i18n.t("cli.run.bad_until"))
    if words == ["-"]:
        command = sys.stdin.read(hubrun.COMMAND_MAX + 1)
    else:
        command = " ".join(words)
    if not command.strip():
        sys.exit(i18n.t("cli.run.usage"))
    if len(command) > hubrun.COMMAND_MAX:
        sys.exit(i18n.t("cli.run.long", max=hubrun.COMMAND_MAX))
    # the Bash hook's bans hold here too: a run is a Bash command that only lives longer (pkill, a mini-hub's git commit)
    bash_bans(command, cwd)
    seq = put("run.requested", ME, {"command": command, "cwd": cwd, "until_at": until or now + hubrun.MAX_LENGTH})
    if seq and seq not in REJECTED:
        rid = f"run{seq}"
        print(i18n.t("cli.run.started", id=rid, until=run_time(until or now + hubrun.MAX_LENGTH, st),
                     log=os.path.join(STATE, "runs", rid, "out.log")))


def bash_bans(command, cwd):
    """The Bash hook's refusals (hooks/deny_hint.reason: pkill, a mini-hub's git commit, ...) for a command a session hands
    to the hub to run outside its own tool call (`hub run`, `hub schedule add --command|--check`): ends the command with
    the hook's text. Only a session is held to them: the owner's terminal has no hook."""
    if not ME:
        return
    from hooks import deny_hint
    st = current()
    sess = st["sessions"].get(ME) or {}
    rules = minihub.deny(sess.get("cwd")) if minihub.on(st, sess) else ()
    why = deny_hint.reason({"command": command, "run_in_background": True}, "Bash", cwd, rules)
    if why:
        sys.exit(why)


def run_time(ts, st):
    from zoneinfo import ZoneInfo
    try:
        zone = ZoneInfo(st["owner"].get("tz") or "UTC")
    except Exception:   # noqa: BLE001
        zone = datetime.timezone.utc
    return datetime.datetime.fromtimestamp(ts, zone).strftime("%d.%m %H:%M")


def run_list(everyone):
    """The session's runs and its executors'; --all — every run (the hub, the owner)."""
    from core import hubrun, i18n, redact
    st = current()
    me = st["sessions"].get(ME or "") or {}
    if everyone and ME and me.get("kind") != "hub":
        sys.exit(i18n.t("cli.run.all_who"))
    rows = []
    for r in sorted(hubrun.runs(st).values(), key=lambda r: r["ts"]):
        owner_of = (st["sessions"].get(r["session"]) or {}).get("raised_by")
        if not (everyone or not ME or ME in (r["session"], owner_of)):
            continue
        took = hubrun.took_text((r.get("ended_at") or time.time()) - (r.get("started_at") or r["ts"]))
        head = redact.mask_head(r["command"].strip().splitlines()[0], 60)   # a key in a command stays out of the list
        if r["state"] == "ended":
            how = f"{r.get('reason') or '?'}" + (f" {r['code']}" if r.get("code") is not None else "")
            rows.append(f"{r['id']}  ended ({how}) after {took}  {r['session']}  {head}")
        else:
            rows.append(f"{r['id']}  {r['state']} {took}, until {run_time(r['until_at'], st)}  {r['session']}  {head}  "
                        f"log {os.path.join(STATE, 'runs', r['id'], 'out.log')}")
    print("\n".join(rows) if rows else i18n.t("cli.run.none"))


CONTROL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")   # C0 except newline and tab; DEL; C1
RAW_IN_JSON = re.compile(r"[\x7f-\x9f]")   # json.dumps(ensure_ascii=False) does not escape them


class Printable:
    """Command output stream without control characters: the command prints what sessions, tools and chats wrote (title
    changes, cursor movement, erased lines). No core module imports: a broken module does not silence hub output."""

    def __init__(self, out):
        self.out = out

    def write(self, text):
        self.out.write(CONTROL.sub("", text))
        return len(text)   # as a stream does: everything given was accepted

    def __getattr__(self, name):
        return getattr(self.out, name)


def json_text(data):
    """JSON for scripts: DEL and C1 escaped (\\u0085), not dropped by the output wrapper."""
    return RAW_IN_JSON.sub(lambda m: f"\\u{ord(m.group()):04x}", json.dumps(data, ensure_ascii=False, indent=1))


def current():
    return journal.load_state(STATE)  # state file + journal tail: not the whole journal (01.10, 211 MB took 5 s)


def verdict_gate(repo):
    """The plugin review verdict is written by the session that received the review task (or its executor), not just
    any session and not a plugin process (audit C13); the owner can too. A verdict is advice to the owner, not a permission."""
    from core import catalog, i18n, minihub
    from modules.market import market
    if OUTSIDER:
        sys.exit(i18n.t("cli.market.verdict_outsider"))
    if not ME:
        return
    rec = market.Market(catalog.config_path(STATE), os.path.join(STATE, "market")).reviews().get(repo) or {}
    to = rec.get("to") or (catalog.load_config(STATE).get("dev") or {}).get("name") or "hub-dev"
    me = current()["sessions"].get(ME) or {}
    if ME != to and not (minihub.runner(me) and me.get("raised_by") == to):
        sys.exit(i18n.t("cli.market.verdict_other", repo=repo, who=to))


def owner_gate(what, ref, lift=False, name=None, bare=True, also=()):
    """New code in the hub (modules, marketplace catalogs and plugins) is the owner's word: a command outside a session,
    or the hub with --for mN (the owner's message to the hub) or qN (the owner's answer to a card of any session) not older
    than a day, by the same rule as risky tools (core/tools.owner_word); a plugin or module process never.
    lift — taking off (remove, uninstall): his message to any session of the hub counts, not only to the hub itself.
    name — what is installed or gets more rights (a source, a module, an entry): the hub's word must name it, as for a
    risky tool (18.11: "show me the status" installed a module and trusted it); bare — by its short name too
    (core/tools.name_forms: not for a new source); also — more names of it (an installed plugin's key)."""
    from core import i18n, tools
    if OUTSIDER:
        sys.exit(i18n.t("cli.module.gate_outsider", what=what))
    if ME:
        st = current()
        if (st["sessions"].get(ME) or {}).get("kind") != "hub":
            sys.exit(i18n.t("cli.module.gate_not_hub", what=what))
        if not ref:
            sys.exit(i18n.t("cli.module.gate_needs_for", what=what))
        try:
            words = tools.owner_word(st, {"sender": ME, "for": ref}, time.time(), cards=True, lift=lift)
        except tools.Rejected as e:
            sys.exit(f"{what}: {e}")
        names = tools.name_forms(name, bare).union(*(tools.name_forms(a) for a in also))
        if name is not None and not lift and not tools.names_any(st, words, names):
            sys.exit(i18n.t("cli.module.gate_not_named", what=what, ref=ref, name=name or what))


def install_name(arg):
    """What the hub's word must name to install a catalog entry or a plugin by link (owner_gate): (name, bare, also). An
    entry of an official or built-in catalog — by its short name too; of a catalog the hub added itself (its author
    names the entries) — <entry>@<catalog>; not an entry — the link in full. Already installed (an update), the names of
    the installed record count too: the owner chose them when he installed it (26.11: his "Check and install" on a card
    about updating a plugin by its short name was refused for not naming its owner/repo). The link's own short name is
    still the requester's choice, and a link installs the repo's root: a plugin from a folder of that repo is another
    one; someone else's source with the same short name is new."""
    from core import catalog, marketplaces, mpinstall
    try:
        cfg = catalog.read_settings(catalog.config_path(STATE))
    except (OSError, ValueError):
        cfg = {}
    try:
        n, rec, _, e = mpinstall.find(STATE, catalog.config_path(STATE), arg)
    except (mpinstall.Error, RuntimeError, OSError, KeyError, TypeError, ValueError):
        return arg, False, installed_names(cfg, lambda x: not x.get("subdir") and same_source(x.get("source"), arg))
    src = str(rec.get("source") or "")
    own = rec.get("official") and marketplaces.is_official(src) or \
        rec.get("builtin") and marketplaces.same(marketplaces.builtin_of(n) or "", src)
    also = installed_names(cfg, lambda x: x.get("market") == n and x.get("entry") == e["name"])
    return f"{e['name']}@{n}", bool(own), also


def same_source(a, b):
    """Two plugin sources are one (case aside): owner/repo, a GitHub link to it with or without .git, an address."""
    from modules.market import market
    a, b = (str(x or "").strip() for x in (a, b))
    key = [(market.repo_of(x) or re.sub(r"\.git$", "", re.sub(r"^[a-z][\w+.-]*://", "", x.lower().rstrip("/")))).lower()
           for x in (a, b)]
    return bool(key[0]) and key[0] == key[1]


def installed_names(cfg, mine):
    """The names of the installed plugins that mine(record) picks: an extension's key (<account>:<name>), a skill set
    entry's <entry>@<catalog> (its record's name is the catalog's: it names every entry from there), a plugin of skills
    only — its key, the name of its `sets` record; a whole set is a catalog, not a plugin."""
    from core import marketplaces
    exts = [k for k, x in (cfg.get("extensions") or {}).items() if isinstance(x, dict) and mine(x)]
    sets = [marketplaces.set_key(x) for x in cfg.get("sets") or [] if isinstance(x, dict) and x.get("name")
            and (x.get("entry") if x.get("plugin") else ":" in str(x["name"])) and mine(x)]
    return {str(k) for k in exts + sets}


def skills_gate(what):
    """A skill set (a plugin of a Claude Code or Codex catalog) and a catalog as a list of entries: the owner, the hub and
    agent-dev, with no --for (owner 2026-11-17: "agent-dev of every hub must be able to do it itself"). Nothing of it
    runs until it is granted to a session, and a grant of what runs code is the owner's word (core/tools). A plugin or
    module process never; another session — a refusal with whom to ask."""
    from core import i18n
    if OUTSIDER:
        sys.exit(i18n.t("cli.module.gate_outsider", what=what))
    if ME:
        st = current()
        if (st["sessions"].get(ME) or {}).get("kind") != "hub" and ME != st.get("trainer"):
            sys.exit(i18n.t("cli.market.skills_gate", what=what, dev=st.get("trainer") or "agent-dev"))


def skills_only(sub, args, flags):
    """`hub marketplace <sub>` touches only catalogs as lists and skill set entries (skills_gate), not code that runs at
    install (a page plugin, a process, a module: owner_gate)."""
    from core import catalog, marketplaces, mpinstall
    cfg_path = catalog.config_path(STATE)
    if sub in ("add", "update"):
        return True
    cfg = catalog.read_settings(cfg_path)
    if sub == "remove":
        name = args[0] if args else ""
        rec = marketplaces._catalogs(cfg).get(name) or {} if isinstance(cfg.get("marketplaces"), dict) else {}
        if rec.get("official") or rec.get("builtin") or name == marketplaces.OFFICIAL_NAME or \
                marketplaces.builtin_of(name):
            return False   # one the hub connects by itself: removed, it never comes back (and the official one revokes)
        if "--uninstall" not in flags:
            return True
        exts = cfg.get("extensions") if isinstance(cfg.get("extensions"), dict) else {}
        mods = cfg.get("modules") if isinstance(cfg.get("modules"), dict) else {}
        sets = cfg.get("sets") if isinstance(cfg.get("sets"), list) else []
        return not any(isinstance(x, dict) and x.get("market") == name for x in [*exts.values(), *(mods.get(
            "sources") or []), *[s for s in sets if isinstance(s, dict) and not s.get("plugin")]])
    if sub == "install" and args:
        try:
            return mpinstall.find(STATE, cfg_path, args[0])[3]["type"] == "skillset"
        except (mpinstall.Error, RuntimeError):
            return False
    if sub == "uninstall" and args:
        sets = cfg.get("sets") if isinstance(cfg.get("sets"), list) else []
        entry, _, where = args[0].partition("@")
        return any(isinstance(x, dict) and x.get("plugin") and x.get("entry") == entry and
                   (x.get("market") == where if where else True) for x in sets)
    return False


def module_cmd(rest):
    """hub module add|update|dev|trust|model|remove: new code in the hub and what it may do is the owner's word (owner_gate)."""
    from core import catalog, modsrc
    sub, args, opts = rest[0], list(rest[1:]), {}
    for flag in ("--ref", "--subdir", "--for"):
        value, args = value_of(args, flag)
        if value is not None:
            opts[flag[2:]] = value
    flags = {f for f in ("--accept", "--dev", "--off") if f in args}
    args = [a for a in args if a not in flags]
    accept = "--accept" in flags
    what = f"hub module {sub}" + "".join(f" {f}" for f in sorted(flags))
    named = None   # what gets new code or rights: the hub's word names it (an update within its rights, --off — as before)
    if sub in ("add", "dev", "trust", "model", "update") and args and "--off" not in flags and (sub != "update" or accept):
        named = os.path.abspath(os.path.expanduser(args[0])) if sub == "add" and modsrc.is_folder(args[0]) else args[0]
    owner_gate(what, opts.get("for"), lift=sub == "remove", name=named, bare=sub != "add")
    if sub == "update" and accept and not args and ME:
        from core import i18n
        sys.exit(i18n.t("cli.module.gate_name_one", what=what))   # new rights of every module: no word names them all
    cfg_path = catalog.config_path(STATE)
    try:
        if sub == "add" and len(args) == 1 and flags <= {"--dev"} and modsrc.is_folder(args[0]):
            if {"ref", "subdir"} & set(opts):
                from core import i18n
                sys.exit(i18n.t("cli.module.folder_no_ref", what=what))
            lines, ok = modsrc.add_path(STATE, cfg_path, args[0], dev="--dev" in flags), True
        elif sub == "add" and len(args) == 1 and "--dev" in flags:
            from core import i18n
            sys.exit(i18n.t("cli.module.dev_folder_only", what=what))
        elif sub == "add" and len(args) == 1 and not flags:
            lines, ok = modsrc.add(STATE, cfg_path, args[0], ref=opts.get("ref"), subdir=opts.get("subdir")), True
            from modules.update import private   # a private module removed earlier is managed by the ensure step again
            private.on_added(STATE, args[0], opts.get("subdir"))
        elif sub == "update" and len(args) <= 1 and flags <= {"--accept"} and not {"ref", "subdir"} & set(opts):
            lines, ok = modsrc.update(STATE, cfg_path, args[0] if args else None, accept)
        elif sub == "dev" and len(args) == 1 and flags <= {"--off"} and not {"ref", "subdir"} & set(opts):
            lines, ok = modsrc.set_dev(STATE, cfg_path, args[0], on="--off" not in flags), True
        elif sub == "trust" and len(args) == 1 and flags <= {"--off"} and not {"ref", "subdir"} & set(opts):
            lines, ok = modsrc.trust(STATE, cfg_path, args[0], on="--off" not in flags), True
        elif sub == "remove" and len(args) == 1 and not flags and not {"ref", "subdir"} & set(opts):
            from modules.update import private   # a private module removed by the owner: the ensure step does not install it again
            mine = private.private_names(STATE, catalog.read_settings(cfg_path), args[0])
            fresh = private.on_removed(STATE, mine)   # before removal: a running ensure step must not install it again in between
            try:
                lines, ok = modsrc.remove(STATE, cfg_path, args[0]), True
            except BaseException:
                private.undecline(STATE, fresh)   # not removed (refusal, failure, Ctrl-C): and the decline recorded just now is withdrawn
                raise
            if mine:
                from core import i18n
                lines.append(i18n.t("cli.module.private_declined", names=", ".join(mine)))
        elif sub == "model" and len(args) == 1 and flags <= {"--off"} and not {"ref", "subdir"} & set(opts):
            lines, ok = modsrc.set_model(STATE, cfg_path, args[0], on="--off" not in flags), True
        else:
            sys.exit(misuse())
    except (RuntimeError, ValueError) as e:
        sys.exit(f"{what}: {e}")
    print("\n".join(lines))
    if not ok:
        sys.exit(1)


def accept_gate(what, accept, ref, name):
    """New permissions (--accept) and revoked items (--despite-revoked) from a hub session only by the owner's answer to
    a card (qN) that names this plugin: their "update X" (mN) is a word about updating, not about new permissions they
    have not seen yet, and an answer to someone else's card is not about this plugin."""
    from core import i18n, mpinstall
    if accept and ME and not (str(ref or "").startswith("q") and mpinstall.card_names(current(), ref, name)):
        sys.exit(f"{what}: {i18n.t('cli.market.accept_card')}")


def plugin_hooks():
    """What plugin commands do in the core: restart a hub-up part, a fact into the journal, a notification to the owner,
    with the same "who speaks" as put (without a channel the spool would flag the fact), but without waiting a tick per event."""
    def give(kind, data):
        spool.put(SPOOL, kind, None, speaker(kind, data), src=SRC)
    return {"restart": lambda parts: give("hub.restart_requested", {"parts": parts}),
            "events": give,
            # from a hub session: no owner.notify (the core does not accept it from a session): it sees the revocation lines in the command output
            "notify": None if ME else lambda title, text: give("owner.notify", {"title": title, "text": text,
                                                                                "source": "marketplaces"})}


def marketplace_cmd(rest):
    """hub marketplace add|remove|update|install|uninstall (the owner's word, owner_gate) and list|search (anyone):
    connected catalogs (core/marketplaces.py) and installation from them (core/mpinstall.py: plugins, modules through
    core/modsrc.py); validate checks your own catalog (core/marketplace.py)."""
    from core import catalog, i18n, marketplace, marketplaces, mpinstall
    if rest[:1] == ["validate"]:
        sys.exit(marketplace.main(rest))
    sub, args = (rest[0] if rest else ""), list(rest[1:])
    word, args = value_of(args, "--for")
    ref, args = value_of(args, "--ref")
    flags = {f for f in ("--auto", "--accept", "--despite-revoked", "--uninstall") if f in args}
    args = [a for a in args if a not in flags]
    what = f"hub marketplace {sub}"
    if sub in ("add", "remove", "update", "install", "uninstall"):
        if skills_only(sub, args, flags):
            skills_gate(what)
        else:
            name, bare, also = install_name(args[0]) if sub == "install" and args and ME and word else (None, False, ())
            owner_gate(what, word, lift=sub in ("remove", "uninstall"), name=name, bare=bare, also=also)
        accept_gate(what, "--accept" in flags or "--despite-revoked" in flags, word, args[0] if args else "")
    cfg_path, ok = catalog.config_path(STATE), True
    hooks = plugin_hooks()
    try:
        if sub == "add" and len(args) == 1 and not flags:
            lines = marketplaces.add(STATE, cfg_path, args[0], ref=ref, **hooks)
        elif sub == "remove" and len(args) == 1 and flags <= {"--uninstall"} and ref is None:
            lines = marketplaces.remove(STATE, cfg_path, args[0], uninstall="--uninstall" in flags,
                                        **{k: hooks[k] for k in ("restart", "events")})
        elif sub == "update" and len(args) <= 1 and ref is None and flags <= {"--auto"} and not (flags and args):
            lines, ok = marketplaces.update(STATE, cfg_path, args[0] if args else None, auto="--auto" in flags, **hooks)
        elif sub == "install" and len(args) == 1 and flags <= {"--accept", "--despite-revoked"} and ref is None:
            lines = mpinstall.install(STATE, cfg_path, args[0], accept="--accept" in flags,
                                      despite_revoked="--despite-revoked" in flags, via="hub" if ME else "cli",
                                      **{k: hooks[k] for k in ("restart", "events")})
        elif sub == "uninstall" and len(args) == 1 and not flags and ref is None:
            lines = mpinstall.uninstall(STATE, cfg_path, args[0], **{k: hooks[k] for k in ("restart", "events")})
        elif sub == "list" and len(args) <= 1 and not flags and ref is None:
            lines = marketplaces.listing(STATE, cfg_path, args[0] if args else None)
        elif sub == "search" and not flags and ref is None:
            lines = marketplaces.search(STATE, cfg_path, args)
        else:
            sys.exit(misuse())
    except mpinstall.NeedsConsent as e:
        sys.exit(f"{what}: {e}" + (f"\n{i18n.t('cli.market.accept_card')}" if ME else ""))
    except (RuntimeError, ValueError) as e:
        sys.exit(f"{what}: {e}")
    print("\n".join(lines))
    if not ok:
        sys.exit(1)


def layout_cmd(rest):
    """hub layout [move <session> <group> | reset]: the session list layout (core/layout.py); sends it whole, like the
    page, from the current revision, so another tab's edit is not overwritten."""
    from core import i18n
    st = current()
    lay = st.get("layout") or {}
    base, groups = lay.get("rev", 0), lay.get("groups")
    if not rest:
        if groups is None:
            print(i18n.t("cli.layout.default_groups",
                         groups=", ".join(g["title"] for g in layout.default_groups(i18n.current()))))
            return
        for g in groups:
            mine = [n for n, x in lay["place"].items() if x == g["id"]]
            print(f"{g['title']} ({g['id']})" + (": " + ", ".join(mine) if mine else ""))
        return
    if rest == ["reset"]:
        put("layout.set", None, {"layout": None, "base": base})
        return
    # the whole layout goes into the journal and the page shows its titles: the standard ones in the owner's language
    new = {"groups": [dict(g) for g in groups or layout.default_groups(i18n.owner())], "place": dict(lay.get("place") or {}),
           "order": {g: list(n) for g, n in (lay.get("order") or {}).items()}}
    # a standard group keeps the owner's title, and the caller reads it in his own language (a session's English): while
    # the title is the standard one, the caller's title names the group too
    kept = {g["id"]: g["title"] for g in layout.default_groups(i18n.owner())}
    shown = {g["id"]: g["title"] for g in layout.default_groups(i18n.current())}

    def named(g, want):
        same = g["title"] == kept.get(g["id"])
        return want.casefold() in (g["title"].casefold(), (shown[g["id"]] if same else g["title"]).casefold())
    if rest[:1] == ["ungroup"] and len(rest) == 2:
        want = rest[1].strip()
        hit = [g for g in new["groups"] if g["id"] == want or named(g, want)]
        if len(hit) != 1:
            sys.exit(i18n.t("cli.layout.group_not_one", want=want, ids=", ".join(g["id"] for g in new["groups"])))
        gid = hit[0]["id"]
        new["groups"] = [g for g in new["groups"] if g["id"] != gid]
        new["place"] = {n: (layout.LOOSE if g == gid else g) for n, g in new["place"].items()}
        new["order"].pop(gid, None)
        put("layout.set", None, {"layout": new, "base": base})
        return
    if rest[:1] != ["move"] or len(rest) != 3:
        sys.exit(misuse())
    name, want = rest[1], rest[2].strip()
    if (st["sessions"].get(name) or {}).get("state", "removed") == "removed":
        sys.exit(i18n.t("cli.layout.session_none", name=name))
    if want == layout.LOOSE:   # outside groups, at the top
        new["place"][name] = layout.LOOSE
        put("layout.set", None, {"layout": new, "base": base})
        return
    hit = [g for g in new["groups"] if g["id"] == want] or \
        [g for g in new["groups"] if named(g, want)]
    if len(hit) > 1:
        sys.exit(i18n.t("cli.layout.groups_many", want=want, ids=", ".join(g["id"] for g in hit)))
    if not hit:
        hit = [{"id": "g-" + uuid.uuid4().hex[:6], "title": want}]
        new["groups"].append(hit[0])
    new["place"][name] = hit[0]["id"]
    put("layout.set", None, {"layout": new, "base": base})


def asker_or_exit(qid):
    """Whose open question card is qid (hub question withdraw | show): the session name; if there is none, exit with a reason."""
    who = next((n for n, x in current()["sessions"].items() for q in x.get("asks") or [] if q["id"] == qid), None)
    if not who:
        from core import i18n
        sys.exit(i18n.t("cli.question.no_open", qid=qid))
    return who


def mcp_decided(type, data):
    """A sign-in fact (hub mcp login) as a decision of the core: (seq, why) — accepted, refused with the reason, or (None,
    None) when the core has not answered (put tells the session it is not lost). The command prints its own lines."""
    seq = put(type, None, data, say=False)
    if seq in REJECTED:
        return None, REJECT_WHY.get(seq) or "rejected"
    return seq, None


def mcp_attempt_wait(attempt, seconds, until, link=False):
    """The attempt's record once `until(record)` is true (or, for link, the link's file appeared: then the second value is
    the link), or None after `seconds`: the core writes the attempt's state, the link lives in a file for the owner only
    (core/mcplogin)."""
    from core import mcplogin
    end, looked = time.time() + seconds, 0
    while True:
        url = mcplogin.link_of(STATE, attempt) if link else None
        if url:
            return None, url
        if time.time() - looked >= 2:   # the state is a big file: not on every look
            looked = time.time()
            a = (current().get("mcp_logins") or {}).get(attempt)
            if isinstance(a, dict) and until(a):
                return a, None
        if time.time() >= end:
            return None, None
        time.sleep(0.3)


def mcp_login_core(st, name, server, redirect, no_browser, confirm):
    """`hub mcp login` on the core's path (core/mcpwatch, the same as the page's "Sign in"): the core signs in through a
    live session where the server waits; the command asks for it, prints the link (or opens the browser of this machine),
    waits for the end and takes the address from another device. False — the core does not know the server as waiting
    (a login from before the update, a server of the hub catalog): the old way, the command's own pty login."""
    from core import coretext, i18n, langdata, mcplogin, mcpwatch
    if server not in (st.get("mcp_waits") or {}):
        return False
    # hubd from before the update (the command is read from disk at once, the core after `hub restart`) takes a sign-in only
    # from the page: its refusal is not an answer — the old way (the core's refusals of before, a prefix: language data)
    old = tuple(langdata.legacy("mcp_refusals"))

    def over(a):
        return a.get("state") in ("done", "failed")

    def end(a, late="cli.mcp.reason_timeout"):
        if a is None:
            sys.exit(i18n.t("cli.mcp.not_done", server=server, why=i18n.t(late)))
        if a["state"] == "failed" or (a["state"] == "open" and a.get("error")):
            sys.exit(i18n.t("cli.mcp.not_done", server=server, why=mcplogin.scrub(mcpwatch.error_text(a) or "")))
        print(i18n.t("cli.mcp.signed_in", server=server))

    if redirect:   # step 2 of a sign-in by link: the address from the person's browser bar goes to the waiting attempt
        active = [a for a in (st.get("mcp_logins") or {}).values()
                  if isinstance(a, dict) and a.get("server") == server and a.get("state") in mcpwatch.ACTIVE]
        if ME and active and not [a for a in active if a.get("by") == "session"]:
            # a sign-in the owner began (the page): its address is his — a session does not touch the file he may have written
            sys.exit(i18n.t("cli.mcp.owners_attempt", server=server))
        if ME:
            active = [a for a in active if a.get("by") == "session"]
        if not active:
            return False
        newest = max(active, key=lambda a: a.get("ts") or 0)
        attempt = newest["id"]
        if newest["state"] != "open":   # the address is already given and checked, or the link is not out yet
            if newest["state"] == "sent":
                a, _ = mcp_attempt_wait(attempt, 90, over)
                end(a, "cli.mcp.pending")
                return True
            sys.exit(i18n.t("cli.mcp.not_done", server=server, why=i18n.t("cli.mcp.no_link_yet")))
        if not mcplogin.RETURN.fullmatch(redirect.strip()):
            sys.exit(i18n.t("cli.mcp.address_bad"))
        mcplogin.put_callback(STATE, attempt, redirect.strip())
        seq, why = mcp_decided("mcp.callback_given", {"attempt": attempt})
        if why or seq is None:
            mcplogin.drop_callback(STATE, attempt)
            if str(why).startswith(old):
                REJECTED.clear()   # the old core's refusal is not the command's: the command goes on its own way
                return False
            sys.exit(i18n.t("cli.mcp.not_done", server=server, why=coretext.human(why) or i18n.t("cli.mcp.core_silent")))
        # the address went to the session: it is checked there (a wrong one — the sign-in waits again, with the reason)
        a, _ = mcp_attempt_wait(attempt, 90, lambda a: a.get("state") != "sent")
        if a is not None and a.get("state") == "open" and not a.get("error"):
            a = None
        end(a, "cli.mcp.pending")
        return True
    fp = ((st["sessions"].get(name) or {}).get("mcp_waits") or {}).get(server)
    # a server from mcp_login_confirm (money, production) needs the owner's word: from his own terminal with --confirm; a
    # session's --confirm is not counted by the core
    seq, why = mcp_decided("mcp.login_requested", {"server": server, "session": name, **({"fp": fp} if fp else {}),
                                                   **({"confirmed": True} if confirm else {})})
    if str(why).startswith(old):
        REJECTED.clear()
        return False
    if why or seq is None:
        sys.exit(i18n.t("cli.mcp.not_started", server=server, why=coretext.human(why) or i18n.t("cli.mcp.core_silent")))
    attempt = f"l{seq}"

    def moved(a):
        return a.get("state") in ("done", "failed", "sent")

    a, url = mcp_attempt_wait(attempt, 75, lambda a: moved(a) or a.get("waking"), link=True)
    if a is not None and a.get("waking") and not moved(a):
        # the holder sleeps and has no old way (Codex): the core wakes it, the sign-in starts once it is up, and its
        # servers start with it (WOKE_PENDING) — the link comes later than from a live session
        a, url = mcp_attempt_wait(attempt, mcpwatch.LIFE, lambda a: moved(a) or not a.get("waking"), link=True)
        if not url and a is not None and not moved(a):
            a, url = mcp_attempt_wait(attempt, 75 + mcpwatch.WOKE_PENDING, moved, link=True)
    if not url:
        if a is not None and a["state"] == "failed":
            sys.exit(i18n.t("cli.mcp.not_started", server=server, why=mcplogin.scrub(mcpwatch.error_text(a) or "")))
        if a is not None:   # signed in without a human (the session's own settings), or at once: until the server is up
            if a["state"] == "sent":
                a, _ = mcp_attempt_wait(attempt, 60, over)
                end(a, "cli.mcp.pending")
            else:
                end(a)
            return True
        sys.exit(i18n.t("cli.mcp.not_started", server=server, why=i18n.t("cli.mcp.no_link")))
    if no_browser or not mcplogin.has_browser():   # a hub without a browser: by link, the person signs in on their side
        print(i18n.t("cli.mcp.link", server=server, url=url, name=name))
        return True
    import webbrowser
    print(i18n.t("cli.mcp.signing_in", server=server), flush=True)
    if not webbrowser.open(url):
        print(url)
    a, _ = mcp_attempt_wait(attempt, mcpwatch.LIFE + 10, over)
    end(a)
    return True


def session_or_exit(name, st=None):
    sess = (st or current())["sessions"].get(name)
    if not sess:
        from core import i18n
        sys.exit(i18n.t("cli.no_session", name=name))
    return sess


def pending_or_exit(name):
    import time
    from core import owner
    sess = session_or_exit(name)
    asks = (sess.get("pending") or []) + owner.open_asks(sess, time.time())   # and the hub's question as a card (04.10)
    if not asks:
        from core import i18n
        sys.exit(i18n.t("cli.answer.nothing_asked", name=name))
    return asks[0]


def answer(name, words):
    """A session's form: the owner's answer, or the hub's for the owner while he is away — then --card qN names the card
    and --why says why and how to roll back (spec d2549241: a session may have a permission and a card at once)."""
    from core import i18n
    card, words = value_of(words, "--card")
    if "--route" in words:   # a deputy's words through the session of their channel (core/deputyroute.py)
        route, words = value_of(words, "--route")
        who, words = value_of(words, "--from")
        msg, words = value_of(words, "--msg")
        text = " ".join(text_words(words)).strip()
        if not (card and route and who and msg and text):
            sys.exit(i18n.t("cli.answer.route_usage"))
        from core import deputycli
        put("question.deputy_answered", name, {"id": card, "route": route, "from": who, "msg": msg, "text": text,
                                               **deputycli.card_address(current(), card)})
        return
    why, replies = value_of(words, "--why")
    if (current()["sessions"].get(ME or "") or {}).get("kind") == "hub" and (card is None) != (why is None) or \
            why is not None and not why.strip():
        sys.exit(i18n.t("cli.answer.card_why"))
    if card is not None:
        req = next((a for a in session_or_exit(name).get("asks") or [] if a["id"] == card), None) or \
            sys.exit(i18n.t("cli.question.no_open", qid=card))
    else:
        req = pending_or_exit(name)
    questions = [q["question"] for q in req["input"].get("questions", [])]
    if req["tool"] != "AskUserQuestion" or not replies or len(replies) != len(questions):
        sys.exit(i18n.t("cli.answer.count_mismatch", name=name, tool=req['tool'], questions=len(questions),
                        replies=len(replies)))
    put("permission.answered", name, {"request_id": req["request_id"], "behavior": "allow",
                                      "answers": dict(zip(questions, replies)),
                                      **({"card": card, "why": why} if card is not None else {})})


def take(name):
    """The hub releases the session, it opens here with a plain claude --resume; after exit it goes back to the hub."""
    from core import i18n
    before = current()
    sess = before["sessions"].get(name) or sys.exit(i18n.t("cli.no_session", name=name))
    if put("session.take_requested", name) in REJECTED:
        sys.exit(1)   # the reason is printed; nothing to wait for
    end = time.time() + 60
    while time.time() < end:
        events = journal.read_tail(os.path.join(STATE, "journal.jsonl"))
        st = current()
        released = any(e["type"] == "host.done" and e["entity"] == name and e["data"].get("do") == "release"
                       and e["seq"] > before["seq"] for e in events)
        if st["sessions"][name]["state"] == "held" and released:
            break
        time.sleep(0.3)
    else:
        sys.exit(i18n.t("cli.take.not_released"))
    from core import codexmodel
    if codexmodel.on_codex(STATE):   # EXPERIMENT (exp/codex-main): the session's conversation is a thread of the hub's Codex
        got = codexmodel.take_command(STATE, name, sess["session_id"])
        if not got:
            put("session.give_requested", name)
            sys.exit(i18n.t(codexmodel.NO_THREAD, name=name))
        try:
            subprocess.call(got[0], cwd=sess.get("cwd") or None, env=got[1], umask=perms.user_umask())
        finally:
            put("session.give_requested", name)
        return
    env = {**os.environ, "HUB_SESSION": name, "HUB_STATE_DIR": STATE}
    cmd = claude_command() + ["--resume", sess["session_id"], "--settings", os.path.join(STATE, "hooks-settings.json"),
                              "--permission-mode", sess.get("mode") or "bypassPermissions"]
    try:
        subprocess.call(cmd, cwd=sess.get("cwd") or None, env=env, umask=perms.user_umask())
    finally:
        put("session.give_requested", name)


def tools_cmd(rest):
    from core import i18n
    st = current()
    cat = st.get("catalog") or {}
    sub = rest[0] if rest else "list"
    if sub == "list" and rest[1:]:   # the session's toolset: for a session that is not up, from when it starts (19.10)
        from core import identity
        from core.tools import ASLEEP
        name = identity.address(st, rest[1]) or rest[1]
        sess = st["sessions"].get(name)
        if not sess or sess["state"] == "removed":
            sys.exit(i18n.t("cli.no_session", name=name))
        for tid in sess.get("tools") or []:
            print(i18n.t("cli.tools.granted_later", tool=tid) if sess["state"] in ASLEEP else f"  {tid}")
        if not sess.get("tools"):
            print(i18n.t("cli.tools.granted_none", name=name))
        return
    if sub == "list":
        for tid, t in sorted(cat.items()):
            risk = i18n.t("cli.tools.list_risk", risk=', '.join(t['risk'])) if t.get("risk") else ""
            bundled = i18n.t("cli.tools.list_with", skills=', '.join(t['with'])) if t.get("with") else ""  # granted only together with it
            print(f"  {tid:<32} {t['kind']:<6} {t.get('description', '')[:90]}{risk}{bundled}")
        if not cat:
            print(i18n.t("cli.tools.catalog_empty"))
        return
    if sub == "discover":  # the owner's own plugins, skills and MCP: which are already in the catalog (core/mine.py)
        from core import mine
        found = mine.discover(STATE)
        mark = lambda x: i18n.t("cli.tools.mark_in_catalog") if x["in_hub"] else i18n.t("cli.tools.mark_no")  # noqa: E731
        print(i18n.t("cli.tools.discover_sets"))
        for x in found["sets"]:
            print(f"  {x['name']:<36} {mark(x):<11} " + i18n.t("cli.tools.discover_enabled", names=', '.join(x['enabled']) or '—'))
        print(i18n.t("cli.tools.discover_skills"))
        for x in found["skills"]:
            print(f"  {x['name']:<36} {mark(x):<11} {x['description'][:70]}")
        print(i18n.t("cli.tools.discover_mcp"))
        for x in found["mcp"]:
            print(f"  {x['name']:<36} {mark(x):<11} {x['type']}")
        print(i18n.t("cli.tools.discover_projects"))
        for x in found["projects"]:
            print(f"  {x['name']:<36} {(i18n.t('cli.tools.mark_in_hub') if x['in_hub'] else i18n.t('cli.tools.mark_no')):<11} {x['path']}")
        return
    if sub == "import" and len(rest) >= 3:
        from core import mine
        if ME and (st["sessions"].get(ME) or {}).get("kind") != "hub":
            sys.exit(i18n.t("cli.tools.import_not_hub"))
        what, name, opts = rest[1], rest[2], rest[3:]
        risk, opts = value_of(opts, "--risk")
        about, opts = value_of(opts, "--about")
        risk, about = risk.split(",") if risk else [], about or ""
        try:
            if what == "set":
                mine.import_set(STATE, name, risk=risk, session=bool(ME))   # the set's risk: every plugin of it
            elif what == "skill":
                mine.import_skill(STATE, name, risk, session=bool(ME))
            elif what == "mcp" and about:
                mine.import_mcp(STATE, name, about, risk, session=bool(ME))   # from the hub: never riskless
            else:
                sys.exit(i18n.t("cli.tools.import_usage"))
        except ValueError as e:
            sys.exit(str(e))
        # hubd re-reads hub.json on its next pass: "added" is printed when the tool is already in the catalog (06.10);
        # if the core is not running or not in time, it is recorded and will pick it up itself: not an error and not a 35 s wait
        ids = {"mcp": lambda c: name in c, "skill": lambda c: f"{name}@{mine.MY_SKILLS}" in c,
               "set": lambda c: any(t.endswith("@" + name) for t in c)}[what]
        end = time.time() + float(os.environ.get("HUB_CLI_WAIT", "5"))
        while not ids(current().get("catalog") or {}) and time.time() < end:
            time.sleep(0.3)
        if ids(current().get("catalog") or {}):
            print(i18n.t("cli.tools.import_added", name=name))
        else:
            print(i18n.t("cli.tools.import_written", name=name))
        return
    if sub in ("remove", "risk") and len(rest) == (2 if sub == "remove" else 3):
        # an entry the hub's settings hold (core/mine): out of the catalog, or its risk words; the same gate as import
        from core import mine
        if ME and (st["sessions"].get(ME) or {}).get("kind") != "hub":
            sys.exit(i18n.t("cli.tools.import_not_hub"))
        tool = rest[1]
        try:
            if sub == "risk":
                got = mine.set_risk(STATE, tool, rest[2].split(","), session=bool(ME))
                print(i18n.t("cli.tools.risk_set", name=tool, risk=", ".join(got) or "—"))
                return
            mine.remove(STATE, tool)
        except ValueError as e:
            sys.exit(str(e))
        gone = lambda c: not any(t == tool or t.endswith("@" + tool) for t in c)   # noqa: E731 — a set: all of its plugins
        end = time.time() + float(os.environ.get("HUB_CLI_WAIT", "5"))
        while not gone(current().get("catalog") or {}) and time.time() < end:
            time.sleep(0.3)
        print(i18n.t("cli.tools.removed" if gone(current().get("catalog") or {}) else "cli.tools.remove_written",
                     name=tool))
        held = sorted(n for n, x in st["sessions"].items() if x.get("state") != "removed"
                      and any(t == tool or t.endswith("@" + tool) for t in x.get("tools") or []))
        if held:
            print(i18n.t("cli.tools.remove_held", names=", ".join(held), name=tool))
        return
    if sub == "request" and len(rest) >= 3 and ME:
        from core.tools import resolve   # a name without @catalog goes to the journal as a full id if there is only one (the core checks again)
        return put("tools.requested", ME, {"tool": resolve(st, st["sessions"].get(ME), rest[1]), "why": " ".join(rest[2:])})
    if sub == "request":   # what is missing: the session, or the reason (13.11: "a session command" was said to sessions too)
        from core import clihelp
        sys.exit(i18n.t("cli.tools.request_session_only") if not ME else
                 i18n.t("cli.tools.request_needs_why") + "\n" + clihelp.load().advice("tools", rest))
    kinds = {"grant": "tools.granted", "deny": "tools.denied", "approve": "tools.approved", "revoke": "tools.revoked"}
    if sub in kinds and len(rest) >= 3:
        from core import identity
        from core.tools import resolve
        name = identity.address(st, rest[1]) or rest[1]   # the journal gets the real hub session name and the full tool id
        if sub == "grant" and "@" in rest[2] and rest[2] not in (st.get("catalog") or {}):
            st = grant_installs(rest[2]) or st
        rest = [rest[0], name, resolve(st, st["sessions"].get(name), rest[2]), *rest[3:]]
        data = {"tool": rest[2]}
        if sub == "grant" and rest[3:]:
            mid, extra = value_of(rest[3:], "--for")
            if mid is None or extra:
                sys.exit(i18n.t("cli.tools.grant_usage"))
            data["for"] = mid
        elif sub == "deny" and len(rest) > 3:
            data["reason"] = " ".join(rest[3:])
        seq = put(kinds[sub], rest[1], data)
        if sub == "grant" and seq:
            from core.tools import grant_note
            sess = current()["sessions"].get(rest[1]) or {}
            req = next((r for r in reversed(sess.get("requests") or []) if r["tool"] == rest[2]), None)
            has = rest[2] in (sess.get("tools") or [])
            if has and (REJECT_WHY.get(seq) == "already has it" or (req or {}).get("had") == seq):   # by the core's answer (17.10: "NOT connected")
                print(i18n.t("cli.tools.grant_already", tool=rest[2], name=rest[1]))
            elif REJECT_WHY.get(seq) == "no live session":   # not a request to the owner: the core did not grant it (17.10, a sleeping session)
                from core.executors import dormant
                print(i18n.t("cli.tools.grant_not_live", tool=rest[2], why=(
                    i18n.t("cli.no_session", name=rest[1]) if not sess or sess["state"] == "removed" else
                    i18n.t("cli.tools.grant_asleep", name=rest[1], tool=rest[2]) if dormant(sess) else
                    i18n.t("cli.tools.grant_state", name=rest[1], state=sess['state']))))
            elif req and req["state"] == "needs-owner" and (
                    not ME or (current()["sessions"].get(ME) or {}).get("kind") == "hub"):   # only the hub cites his word
                print(i18n.t("cli.tools.grant_needs_owner", tool=rest[2], name=rest[1]))
            elif has and seq not in REJECTED:
                words = (req or {}).get("owner_words")
                print(i18n.t("cli.tools.grant_done", tool=rest[2])
                      + (i18n.t("cli.tools.grant_by_word", message=words['message'], text=words['text'][:80]) if words else "")
                      + grant_note(sess.get("state")))
        return seq
    sys.exit(misuse())


def grant_installs(tool):
    """`hub tools grant <session> <entry>@<catalog>` of a skill set entry not yet in the hub's catalog: install it first
    (skills_gate), wait until hubd has it in the catalog (it re-reads hub.json on its next pass), -> the fresh state;
    None — not such an entry (the grant goes as is and the core answers). Not in time — say so and exit: the grant
    is not lost silently."""
    from core import catalog, i18n, mpinstall
    cfg_path = catalog.config_path(STATE)
    try:
        e = mpinstall.find(STATE, cfg_path, tool)[3]
    except (mpinstall.Error, RuntimeError):
        return None
    if e["type"] != "skillset":
        return None
    skills_gate(f"hub marketplace install {tool}")
    try:
        lines = mpinstall.install(STATE, cfg_path, tool, via="hub" if ME else "cli",
                                  **{k: v for k, v in plugin_hooks().items() if k in ("restart", "events")})
    except mpinstall.NeedsConsent as err:
        sys.exit(f"hub marketplace install {tool}: {err}")
    except (RuntimeError, ValueError) as err:
        sys.exit(f"hub marketplace install {tool}: {err}")
    print("\n".join(lines))
    end = time.time() + float(os.environ.get("HUB_GRANT_WAIT", "30"))
    while time.time() < end:
        st = current()
        if tool in (st.get("catalog") or {}):
            return st
        time.sleep(0.5)
    sys.exit(i18n.t("cli.tools.grant_installed_later", tool=tool))


def schedule_cmd(rest):
    import argparse
    from core import i18n, schedule, views
    sub = rest[0] if rest else "list"

    class Parser(argparse.ArgumentParser):
        def error(self, message):   # argparse's words, then the common mistake that names them, the form and an example
            from core import clihelp
            token = "not allowed with" if "not allowed with argument" in message else message   # either order
            self.exit(2, f"{self.prog}: {message}\n" + clihelp.load().advice("schedule", rest, token) + "\n")
    ap = Parser(prog=f"hub schedule {sub}")
    if sub == "add":
        ap.add_argument("--session", default=None)   # for --command: who gets the command; if not set, as before
        when = ap.add_mutually_exclusive_group(required=True)
        when.add_argument("--at")
        when.add_argument("--every")
        when.add_argument("--cron")
        what = ap.add_mutually_exclusive_group(required=True)
        what.add_argument("--prompt")
        what.add_argument("--command")  # monitor: a script on a schedule that writes to the owner itself via hub notify
        ap.add_argument("--check")  # pre-check of a session job: the clock runs it before the turn, 0 means do not wake, 3 means wake
        ap.add_argument("--check-timeout")   # seconds the pre-check may run (the core validates: 1-900, default 120)
        ap.add_argument("--until")
        ap.add_argument("--id")
        a = ap.parse_args(rest[1:])
        if (a.check or a.check_timeout) and a.command:
            sys.exit(i18n.t("cli.schedule.check_prompt_only"))
        if a.check_timeout and not a.check:
            sys.exit(i18n.t("cli.schedule.check_timeout_needs_check"))
        if a.command and not a.id:
            sys.exit(i18n.t("cli.schedule.command_needs_id"))
        session = a.session or (None if a.command else ME)
        if not a.command and not session:
            sys.exit(i18n.t("cli.schedule.whom"))
        for text in (a.command, a.check):   # both are run by the clock as a shell command, outside the session's tool call
            if text:
                bash_bans(text, os.getcwd())
        jid = a.id or f"{session}-{uuid.uuid4().hex[:4]}"
        spec = {k: v for k, v in (("session", session), ("at", a.at), ("every", a.every),
                                   ("cron", a.cron), ("prompt", a.prompt), ("command", a.command),
                                   ("check", a.check), ("check_timeout", a.check_timeout), ("until", a.until)) if v}
        seq = put("schedule.set", jid, spec)
        if a.prompt and (a.every or a.cron) and not a.check and seq not in REJECTED:
            print(i18n.t("cli.schedule.check_hint"))   # 11.11: polling jobs without a pre-check woke the model on every tick
    elif sub == "extend":
        ap.add_argument("id")
        ap.add_argument("--until")
        a = ap.parse_args(rest[1:])
        st = current()
        try:
            spec = schedule.extend_spec((st.get("schedule") or {}).get(a.id), a.until, time.time(), st["owner"]["tz"])
        except schedule.Invalid as e:
            sys.exit(str(e))
        put("schedule.set", spec.pop("id"), spec)
    elif sub == "list":
        ap.add_argument("--session")
        ap.add_argument("--all", action="store_true")
        ap.add_argument("--full", action="store_true")   # full job texts (by default the first 200 characters)
        a = ap.parse_args(rest[1:])
        st = current()
        def cut(text):   # 24.10: the command tail used to be cut silently, so an edit at the end of the text could not be seen
            return text if a.full or len(text) <= 200 else text[:200] + f"… (+{len(text) - 200}, --full)"
        tz, now = st["owner"]["tz"], time.time()
        jobs = [j for j in st.get("schedule", {}).values()
                if (a.all or j["state"] in ("active", "paused", "expired")) and (not a.session or schedule.owner_of(st, j) == a.session)]
        if not jobs:
            print(i18n.t("cli.schedule.list_none"))
        for j in sorted(jobs, key=lambda j: j["id"]):
            state = schedule.state_text(j, now, tz)
            to = f"$ {cut(j['command'])}" + (i18n.t("cli.schedule.list_exit", code=j['last_exit']) if "last_exit" in j else "") \
                if j.get("command") else cut(j["prompt"])
            if j.get("check"):
                to += "\n" + (i18n.t("cli.schedule.list_check_last", check=cut(j['check']), quiet=j.get('quiet', 0),
                                     code=j['last_check']) if "last_check" in j else
                              i18n.t("cli.schedule.list_check", check=cut(j['check']), quiet=j.get('quiet', 0)))
                if j.get("check_timeout"):
                    to += i18n.t("cli.schedule.list_check_timeout", seconds=j["check_timeout"])
            whose = f" · {schedule.owner_of(st, j)}" if j.get("command") and schedule.owner_of(st, j) else ""   # whose command
            print(i18n.t("cli.schedule.list_row", id=j['id'],
                         to=j['session'] if not j.get('command') else i18n.t("cli.schedule.list_command") + whose,
                         when=schedule.when_text(j, tz), state=state, by=views.job_by_word(j.get('by')), runs=j.get('runs', 0), what=to))
    elif sub == "rm" and len(rest) == 2:
        seq = put("schedule.remove_requested", rest[1])
        if seq and seq not in REJECTED and (current().get("schedule", {}).get(rest[1]) or {}).get("state") == "removed":
            print(i18n.t("cli.schedule.rm_done", id=rest[1]))   # the hub used to read "accepted" as "not done" (06.10)
    elif sub == "retarget" and len(rest) == 3:
        put("schedule.retarget", rest[1], {"session": rest[2]})
    elif sub == "apply":
        ap.add_argument("--session")
        ap.add_argument("file", nargs="?", default="-")
        a = ap.parse_args(rest[1:])
        raw = platforms.current.read_stdin() if a.file == "-" else open(a.file, encoding="utf-8").read()
        try:
            jobs = json.loads(raw)
        except ValueError as e:
            sys.exit(i18n.t("cli.schedule.apply_not_json", error=e))
        if isinstance(jobs, dict):
            jobs = jobs.get("jobs")
        put("schedule.applied", None, {"jobs": jobs, "scope": {"session": a.session} if a.session else {}})
    else:
        sys.exit(misuse())


def open_asks_only(st, now):
    """The state for scripts: a session's asks are the cards still open (as the page and `hub question show` count
    them); the ones stale by owner.ASK_TTL are in asks_stale."""
    from core import owner
    sessions = {}
    for name, s in st["sessions"].items():
        opened = owner.open_asks(s, now)
        stale = [a for a in s.get("asks") or [] if a not in opened]
        sessions[name] = {**s, "asks": opened, "asks_stale": stale} if stale else s
    return {**st, "sessions": sessions}


def status(as_json):
    from core import coretext, i18n
    st = current()
    if as_json:
        print(json_text(open_asks_only(st, time.time())))
        return
    when = lambda ts: datetime.datetime.fromtimestamp(ts).strftime("%H:%M:%S") if ts else "—"  # noqa: E731
    print(i18n.t("cli.status.journal_seq", seq=st['seq']))
    pending = spool.pending(SPOOL)
    why = pending and spool.stalled(SPOOL, STATE)
    if why:   # hubd just restarting or starting: the mailbox waits for a few seconds — not a warning
        print(i18n.t("cli.status.spool_pending" if why == "down" else "cli.status.spool_slow", n=pending))
    if (st.get("restart") or {}).get("state") == "waiting" or st.get("restart_parts"):
        from core import catalog
        try:
            minutes = restart.ceiling(catalog.load_config(STATE))
        except (ValueError, AttributeError):   # broken hub.json (or not an object): the default ceiling
            minutes = restart.WAIT_MINUTES
        if (st.get("restart") or {}).get("state") == "waiting":
            print(restart.note(st, time.time(), minutes) + "   → hub restart --now | --cancel")
        parts = restart.parts_note(st, time.time(), minutes)
        if parts:
            print(parts + "   → hub restart <part> --now")
    from modules.tailnet import access as tailnet_access
    off = tailnet_access.status_line(STATE)   # off until turned on, or not working: why and how, not silence
    if off:
        print(off)
    print("\n" + i18n.t("cli.status.sessions_head"))
    from core import deputyroute, executors, owner
    asleep = [s["name"] for s in st["sessions"].values() if executors.dormant(s)]
    taken = minihub.busy_if_needed(st)   # who has work: one pass, if someone is waiting for a handover
    waits, queue = minihub.waits(st), minihub.queue(st)   # mini-hubs wait for executors; their queue is under them
    from core import specmode
    specs = specmode.open_by_session(st)   # executors' open specs, one pass
    now = time.time()   # one clock for every row
    for s in st["sessions"].values():
        if s["state"] == "removed" or (executors.dormant(s) and "--all" not in sys.argv):
            continue   # executors that handed in sleep and do not interfere (owner decision 2026-10-04: the hub forgets them permanently)
        # parked: no process until a message; retired: an executor that handed in (visible with --all)
        print(f"  {s['name']:<20} {s['state']:<9} " + i18n.t("cli.status.session_row", since=when(s['since']),
                                                                pid=s['pid'] or '—', restarts=s['restarts'], id=s['session_id']))
        if s.get("role") == "agent":
            print(i18n.t("cli.status.agent_row", icon=s.get('icon') or '', about=s.get('about') or '').rstrip())
        if s.get("tools"):
            print(i18n.t("cli.status.tools_row", tools=', '.join(s['tools'])))
        later = minihub.pending(st, s, taken)   # will switch after the current task
        if minihub.on(st, s):   # does not execute itself, delegates to its own executors (hub parallelism)
            dirty = minihub.dirty(st, s)   # uncommitted changes in the folder: the triage will be handed to an executor
            wait = minihub.waits_label(waits.get(s["name"]))
            mine = minihub.own(s)   # its own executor count (hub session parallel), otherwise the general parallelism
            print(i18n.t("cli.status.minihub_row") + "".join(
                f"; {x}" for x in (i18n.t("cli.status.minihub_own", n=mine) if mine else None, wait, dirty) if x))
            for q in (q for q in queue if q["by"] == s["name"]):   # like the rows under it on the page
                print("        " + minihub.queue_line(q))
        elif minihub.boss(st, s):   # bus: the owner only through the mini-hub
            print(i18n.t("cli.status.bus_row", bus=s['bus'], boss=minihub.boss(st, s)))
        elif later:
            print(f"      {later}")
        elif minihub.alone(st, s):   # parallelism 0 or "self"
            why = coretext.human(minihub.solo(s))
            print(i18n.t("cli.status.solo_why", why=why) if why else i18n.t("cli.status.solo_none"))
        sp = specs.get(s["name"])
        if sp:   # spec mode: the executor writes its spec; ready — it waits for the owner's "Accept" (hub task spec)
            print(i18n.t("cli.status.spec_waits" if sp["state"] == "spec" else "cli.status.spec_writes", id=sp["id"],
                         path=specmode.abs_path(STATE, sp["spec"]["path"])))
        if s.get("spec"):
            print(i18n.t("cli.status.specs_on"))
        starting = parking.mcp_wait(s, now)   # a new process that has not read its input: not a free "idle"
        if starting:
            print(i18n.t("cli.status.mcp_wait_row" if starting["servers"] else "cli.status.mcp_wait_row_all",
                         servers=', '.join(starting["servers"]), left=max(0, round(starting["until"] - now))))
        if (s.get("info") or {}).get("mcp_auth"):  # MCP waits for sign-in: no tools until they sign in and restart
            print(i18n.t("cli.status.mcp_auth_row", servers=', '.join(s['info']['mcp_auth']), name=s['name']))
        failed = (s.get("info") or {}).get("mcp_failed")
        if failed and s["state"] in reducer.LIVE and not s.get("mcp_init"):   # granted is not up: the tools row alone says it works
            print(i18n.t("cli.status.mcp_failed_row", servers=', '.join(failed), server=failed[0], name=s['name']))
        if s.get("plugins_stale"):   # an updated plugin: the core restarts the session itself when it is free and has no background work
            print(i18n.t("cli.status.plugins_stale_row", plugins=', '.join(s['plugins_stale'])))
        if s.get("env_missing"):   # its process went without a module's launch.env: restarts after the module's next start, once free
            print(i18n.t("cli.status.env_missing_row", modules=', '.join(s['env_missing']), name=s['name']))
        if (s.get("info") or {}).get("problem"):  # the Claude Code version does not support the hub on this OS (platforms.claude_problem)
            print(f"      {s['info']['problem']}")
        if s.get("attention") and s["state"] == "idle":
            a = s["attention"]
            print(i18n.t("cli.status.attention_row", ask=a.get('ask') or (a.get('text') or '')[-120:]))
        for r in s.get("requests") or []:
            if r["state"] in ("requested", "needs-owner"):
                who = i18n.t("cli.status.request_owner") if r["state"] == "needs-owner" else i18n.t("cli.status.request_hubs")
                print(i18n.t("cli.status.request_row", tool=r['tool'], why=r.get('why') or '', who=who, name=s['name']))
        for ask in owner.open_asks(s, time.time()):   # qN cards (13.10: the "what is waiting for the owner" summary used to be dug out of the journal)
            shown = i18n.t("cli.status.ask_shown_in", where=ask['shown']) if ask.get("shown") else ""
            if deputyroute.at(ask):   # a card at a deputy waits for their answer, not the owner's
                key = "ask_row_answered" if ask["deputy"]["state"] == deputyroute.ANSWERED else "ask_row_routed"
                print(i18n.t(f"cli.status.{key}", id=ask['id'], shown=shown, text=owner.question_text(ask)[:160],
                             name=ask["deputy"].get("name") or "?"))
                continue
            print(i18n.t("cli.status.ask_row", id=ask['id'], shown=shown, text=owner.question_text(ask)[:160]))
        for req in s.get("pending") or []:
            if req["tool"] == "AskUserQuestion":
                for q in req["input"].get("questions", []):
                    opts = " / ".join(o.get("label", "") for o in q.get("options", []))
                    print(i18n.t("cli.status.question_row", question=q['question'], opts=opts, name=s['name']))
            else:
                print(i18n.t("cli.status.permit_row", tool=req['tool'],
                             input=json.dumps(req['input'], ensure_ascii=False)[:80], name=s['name']))
    waiting = [n for n, r in (st.get("runs") or {}).items() if r.get("state") == "queued"]
    if waiting:
        print(i18n.t("cli.status.queued_row", n=len(waiting), names=', '.join(waiting)))
    if st.get("queue_paused"):
        print("  " + i18n.t("cli.task.queue_paused_status"))
    if asleep and "--all" not in sys.argv:
        print(i18n.t("cli.status.asleep_row", n=len(asleep)))
    msgs = sorted(st["messages"].values(), key=lambda m: (m["created"], m["id"]))[-10:]
    if msgs:
        print("\n" + i18n.t("cli.status.messages_head"))
    for m in msgs:
        extra = i18n.t("cli.status.attempt_n", n=m['attempt']) + (f", {m['reason']}" if m.get("reason") else "")
        print(f"  {m['id']:<6} → {m['session'] or m['to']:<16} {m['state']:<9} {extra}  {m['text'][:40]!r}")


WAIT_FIRST = 10  # minutes after sending: the first check; the second is at the end of the --for period
WAIT_NOT_A_TEXT = {"list", "ls", "show", "status", "cancel", "clear", "remove", "rm", "help", "--help", "-h"}


def wait_cmd(rest):
    """Wait for a person's reply with short self-checks (owner request 2026-10-01: the check was set for tomorrow, but
    the reply came after 2 minutes)."""
    from core import i18n
    if not ME:
        sys.exit(i18n.t("cli.wait.from_session"))
    if rest[:1] == ["done"]:
        from core import schedule
        st = current()
        # by what the job is and whose it is: a renamed session keeps its checks under the old name; a job with a
        # `check` or a repeat is a watcher, not one of ours (`hub wait` sets only one-off `at` jobs without a check;
        # older jobs have no `wait` field)
        mine = [j for j, x in st.get("schedule", {}).items()
                if schedule.WAIT_ID.match(j) and x.get("session") == ME and x["state"] == "active"
                and x.get("kind") == "at" and not x.get("check")]
        label = " ".join(rest[1:]).strip()
        if label:   # one wait of several: its tag (the middle of the id, as its checks say) or a piece of what it waits for
            def tag(j):
                return schedule.WAIT_ID.match(j)[1].rsplit("-", 1)[1]
            waits = {j: str(st["schedule"][j].get("wait") or "") for j in mine}
            hit = [j for j in mine if tag(j) == label.lower()]
            if not hit and re.fullmatch(r"[0-9a-f]{4}", label.lower()):
                mine = []   # a check names its tag, and its wait is gone already (the last check is not active when it runs)
            elif not hit:
                hit = [j for j in mine if label.lower() in waits[j].lower()]
                left = "; ".join(sorted({waits[j][:60] or j for j in (hit or mine)})) or "-"
                if not hit:
                    sys.exit(i18n.t("cli.wait.done_no_match", label=label, waiting=left))
                if len({tag(j) for j in hit}) > 1:   # a word several waits share: not a guess
                    sys.exit(i18n.t("cli.wait.done_many", label=label, waiting=left))
            if hit:
                mine = hit
        done = [seq for seq in (put("schedule.remove_requested", jid) for jid in mine) if seq not in REJECTED]
        if done or not mine:   # refused (the reason is printed, code 1): nothing was removed to claim
            print(i18n.t("cli.wait.removed_checks", n=len(done)))
        return
    limit, words = value_of(rest, "--for")
    limit = limit or "4h"
    what = " ".join(words).strip()
    # one command-like word ("list", "status") is a subcommand that does not exist, not what is awaited: it armed checks
    # with the text "list"
    if not what or what.lower() in WAIT_NOT_A_TEXT:
        from core import clihelp
        help_ = clihelp.load()
        sys.exit((i18n.t("cli.help.no_subcommand", cmd="wait", word=what, subs=", ".join(help_.subcommands("wait")))
                  if what else i18n.t("cli.wait.usage_line")) + "\n" + help_.advice("wait", rest))
    unit = {"m": 60, "h": 3600}.get(limit[-1:], 0)
    if not unit or not limit[:-1].isdigit() or not int(limit[:-1]):
        sys.exit("--for: 30m, 2h, 4h …")
    horizon = int(limit[:-1]) * unit
    tag, now = uuid.uuid4().hex[:4], time.time()
    # the channel without names: in one hub the messenger belongs to a secretary agent, in another to the session itself
    # (09.10: a check told a session without access to read Teams)
    prompt = (f"[waiting for reply] {what}. Check now; a reaction to your message (👍, ➕, ✅) is a reply too, read with "
              "reactions. If the channel is not among your tools, ask the agent that has it (the list of agents is in your "
              f"instructions). If there is a reply, run `hub wait done {tag}` (it removes the other checks of this wait) and "
              "go on with the task. If there is none, do nothing else and end the turn with the single character \"—\".")
    # 16.10: of eight checks (2, 5 ... 240 min) 116 of 122 turns ended with "—"; real replies were found on the 2nd,
    # 6th and 8th: so two checks: a quick reply after 10 min, a late one at the end of the period (later, but not lost)
    steps = sorted({min(WAIT_FIRST, horizon // 60), horizon // 60} - {0})
    seqs = [put("schedule.set", f"{ME}-wait-{tag}-{k + 1}", {"session": ME, "at": now + m * 60, "prompt": prompt,
                                                             "wait": what}) for k, m in enumerate(steps)]
    if any(seq not in REJECTED for seq in seqs):   # refused (the reason is printed, code 1): not armed
        print(i18n.t("cli.wait.armed", count=len(steps), times=', '.join(
            i18n.t("cli.wait.in_hours", n=m // 60) if m >= 60 and not m % 60 else i18n.t("cli.wait.in_minutes", n=m)
            for m in steps)))


def app_src(rest):
    """hub app src [--repo URL]: the core's working copy of a hub from the one-line install (core/ownsrc.py) — made, or
    its `release` brought onto the release the hub runs; then what it is."""
    from core import i18n, ownsrc
    if rest not in ([], ["--json"]) and not (len(rest) == 2 and rest[0] == "--repo" and rest[1][:1] not in ("", "-")):
        print(usage(["app"]), file=sys.stderr)
        return 2
    code = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    try:
        got = ownsrc.make(STATE, code, url=rest[1] if rest[:1] == ["--repo"] else None,
                          say=lambda line: print(line, file=sys.stderr, flush=True))
    except ownsrc.Refused as e:
        print(i18n.t("cli.app.src_refused", why=e), file=sys.stderr)
        return 1
    if rest == ["--json"]:
        print(json.dumps(got, ensure_ascii=False))
        return 0
    print(i18n.t("cli.app.src", path=got["path"], version=got.get("version") or "?", commit=got.get("commit") or "?",
                 count=got.get("edits") or 0))
    print(i18n.t("cli.app.src_clone", source=got["source"]) if got.get("kind") == "clone" else
          i18n.t("cli.app.src_archive"))
    if got.get("dirty"):
        print(i18n.t("cli.app.src_dirty"))
    return 0


def app_apply(rest, wait=60):
    """hub app apply: the hub's code of the working copy's local (core/ownsrc.py build), left by the update process for
    the person's restart under the release's watchdog (modules/update/layer.py apply_own)."""
    from core import i18n, ownsrc
    if rest:
        print(usage(["app"]), file=sys.stderr)
        return 2
    code = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    try:
        got = ownsrc.build(STATE, code, say=lambda line: print(line, file=sys.stderr, flush=True))
    except ownsrc.Refused as e:
        print(i18n.t("cli.app.apply_refused", why=e), file=sys.stderr)
        return 1
    print(i18n.t("cli.app.apply_built", version=got["version"], count=got["edits"]), flush=True)
    ownsrc.request(STATE, got)
    end = time.time() + wait   # the update process looks every 15 s
    while (done := ownsrc.result(STATE, got["name"])) is None and time.time() < end:
        time.sleep(1)
    if done is None and ownsrc.withdraw(STATE):   # no update process answers: no build taken hours later unasked
        print(i18n.t("cli.app.apply_later"), file=sys.stderr)
        return 1
    while (done := ownsrc.result(STATE, got["name"])) is None and time.time() < end + wait:   # taken: its answer
        time.sleep(1)
    result = (done or {}).get("result")
    if result is None:
        print(i18n.t("cli.app.apply_bad", error="no answer"), file=sys.stderr)
        return 1
    if result == "applied":
        print(i18n.t("cli.app.apply_ready", release=got["release"]))
        return 0
    print(i18n.t(f"cli.app.apply_{result.replace('-', '_')}" if result in (
        "current", "moved", "waits", "busy", "needs-runtime", "needs-claude") else "cli.app.apply_bad",
                 error=(done or {}).get("error") or "?"), file=sys.stderr)
    return 1


def app_cmd(rest):
    """hub app find|move|stay|undo: the move of a hub from a git clone into the app (core/appmove.py, app spec §8);
    hub app src — the core's working copy of a hub from the one-line install."""
    from core import appmove, catalog, i18n
    cfg = os.path.dirname(catalog.config_path(STATE))
    if rest[:1] == ["src"]:
        return app_src(rest[1:])
    if rest[:1] == ["apply"]:
        return app_apply(rest[1:])
    try:
        if rest[:1] == ["find"] and rest[1:] in ([], ["--json"]):
            found = appmove.find(STATE)
            if "--json" in rest:
                print(json.dumps({**found, "texts": appmove.texts(found)} if found else {}, ensure_ascii=False))
            elif found:
                print(i18n.t("cli.app.found", repo=found["repo"], version=found.get("version") or "?"))
            else:
                print(i18n.t("cli.app.none"))
            return 0 if found else 3
        if rest == ["move", "--done"]:
            return 0 if appmove.done(STATE) else 1
        if rest[:1] == ["move"] and len(rest) == 4 and rest[2] == "--app":
            appmove.move(STATE, cfg, rest[1], rest[3], say=lambda line: print(line, flush=True))
            print(i18n.t("cli.app.prepared"), flush=True)
            return 0
        if rest == ["stay"]:
            appmove.stay(STATE)
            return 0
        if rest[:1] == ["undo"] and rest[1:] in ([], ["--failed"]):
            rec = appmove.undo(STATE, failed=rest[1:] == ["--failed"])
            if rec.get("status") == "moving":   # the clone's service did not start: the hub may run nowhere
                from core import instance
                print(i18n.t("cli.app.not_back", command=instance.command_name(rec.get("instance"))), file=sys.stderr)
            else:
                print(i18n.t("cli.app.undone", repo=rec.get("repo") or "?"))
            for line in rec.get("left") or []:
                print(i18n.t("cli.app.left", what=line), file=sys.stderr)
            return 4 if rec.get("status") == "moving" else 0   # not finished: the shells say `hub app undo` again
    except appmove.NotBack as e:   # the move failed midway and its return did not finish either: as undo's 4
        print(str(e), file=sys.stderr)
        return 4
    except appmove.Refused as e:
        print(str(e), file=sys.stderr)
        return 1
    print(usage(["app"]), file=sys.stderr)
    return 2


def page_answers(port, timeout=2):
    import socket
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=timeout):
            return True
    except OSError:
        return False


def service_cmd(cmd, printing=False):
    """hub on / off / ui / open: turn the hub on and off under the OS service (launchd, systemd --user), open the page;
    open — the hub turned on first when its page does not answer; where no browser can come up (Linux without a display:
    a server) — the link and the SSH tunnel that brings it to the person's computer (core/remote.tunnel)."""
    from core import i18n
    unit = platforms.current.service_unit(STATE)
    port = web_port(unit)
    url = f"http://localhost:{port}/"
    # the owner opens the page too: otherwise a session would open a tab on their screen (review, 07.10)
    if ME or OUTSIDER:
        sys.exit(i18n.t("cli.service.owner_terminal", cmd=cmd))
    if cmd == "open":
        if not page_answers(port):
            if not unit:
                sys.exit(i18n.t("cli.service.no_unit", python=sys.executable, path=os.path.join(
                    os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'bin', 'hub-up')))
            service_cmd("on")
            end = time.time() + 60
            while not page_answers(port) and time.time() < end:
                time.sleep(1)
            if not page_answers(port):   # the link anyway (it may come up later), but not silently
                print(i18n.t("cli.service.open_not_up", log=os.path.join(STATE, "logs", "hub-up.log")),
                      file=sys.stderr)
        cmd = "ui"   # no browser here: the link and the SSH tunnel to it (below)
    if cmd == "ui":
        from core import pagekey, pagepass
        # the old link with a key of a hub in the state "key" (core/pagepass.py): the link signs this browser in; a
        # password is typed on the page itself
        key = pagekey.read() if pagepass.state() == "key" else None
        if key == pagekey.BROKEN:   # the old key's file is damaged: nobody gets in from here until a password or off
            from core import instance
            print(i18n.t("cli.pass.status_key", cmd=instance.command_name(instance.name())), file=sys.stderr)
        url = pagekey.link(port, key) if key else url
        if printing:
            print(url)
            return
        if not platforms.current.has_browser(os.environ) and not os.environ.get("BROWSER"):
            # a server (no screen, no browser command of the person's): the page comes to their computer by SSH
            import getpass
            from core import remote
            print(url)
            print(i18n.t("cli.service.tunnel", url=url))
            print("  " + remote.tunnel(port, files_port(unit), getpass.getuser(), os.environ))
            return
        import webbrowser
        print(url)   # a browser may not come up (a server, a snap browser that does not read hidden folders): copy it
        if key and platforms.current.ARGS_SEEN_BY_ALL:   # not in the browser's command line: every account reads those
            from pathlib import Path
            webbrowser.open(Path(pagekey.opener(STATE, url)).as_uri())
        else:
            webbrowser.open(url)
        return
    if not unit:
        if cmd == "off":
            return main(["stop"])
        sys.exit(i18n.t("cli.service.no_unit", python=sys.executable, path=os.path.join(
            os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'bin', 'hub-up')))
    c = platforms.current.service_commands(unit)
    if cmd == "off" and not c["off"]:
        main(["stop"])   # the Windows task will not bring the hub up again: a soft stop of hub-up
        print(i18n.t("cli.service.stays_off"))
        return

    def up():
        return bool(c["status"]) and subprocess.run(c["status"], capture_output=True).returncode == 0
    if cmd == "off":
        if not up():
            print(i18n.t("cli.service.was_off", id=unit['id']))
            return
        subprocess.run(c["off"], check=False)
        end = time.time() + 30   # bootout does not wait for the hub to finish its snapshot (deploy/mac/install.sh)
        while up() and time.time() < end:
            time.sleep(0.5)
        print(i18n.t("cli.service.turned_off", id=unit['id']))
        # what brings it back by itself: launchd loads the agent at the next sign-in; systemd's user manager outlives a
        # sign-out when it lingers (the installer asks for it) and starts the unit at the next boot, else at a sign-in
        boot = unit["kind"] == "systemd" and platforms.current.lingers()
        print(i18n.t("cli.service.stays_off_boot" if boot else "cli.service.stays_off_login"))
        return
    if c["status"] and up():
        print(i18n.t("cli.service.was_on", url=url))
        return
    try:   # the hub was stopped by `hub stop` / `hub off`; we turn it on: otherwise hub-up from the scheduler (Windows) would exit at once
        os.unlink(os.path.join(STATE, restart.HELD))
    except FileNotFoundError:
        pass
    r = subprocess.run(c["on"], capture_output=True)   # bytes: schtasks writes in the console's OEM code page, not UTF-8
    if r.returncode != 0:
        error = platforms.current.output_text(r.stderr or r.stdout or b"")
        sys.exit(i18n.t("cli.service.on_failed", error=error.strip()[:300]))
    print(i18n.t("cli.service.turned_on", id=unit['id'], url=url))


IMPORT_WAS_UP = []   # `hub import` found the hub running: only then it is started again (one turned off stays off)


def import_stop():
    """`hub import` stops this hub as `hub off` does (its service; without one — the soft stop of hub-up) and waits for
    its hubd to let go of the state folder. -> True when it is down."""
    from core import lock, restart
    if restart.running(STATE):
        IMPORT_WAS_UP.append(True)
        try:
            main(["off"])
        except SystemExit:
            pass
    end = time.time() + 120   # as `hub app move` waits (core/appmove.STOP_WAIT)
    while restart.running(STATE) and time.time() < end:
        time.sleep(1)
    held = lock.acquire(os.path.join(STATE, "hubd.lock"))
    if held is None:
        return False
    held.close()
    return not restart.running(STATE)


def import_start():
    """The hub up again after `hub import` — through its service; a hub without one is started by hand; one that was
    off before stays off (the line says how to start it)."""
    from core import i18n
    if not IMPORT_WAS_UP:
        print(i18n.t("cli.import.was_off"))
        return
    if not platforms.current.service_unit(STATE):
        print(i18n.t("cli.import.start_by_hand"))
        return
    try:
        main(["on"])
    except SystemExit as e:
        if e.code not in (None, 0):
            print(e.code, file=sys.stderr)


def password_cmd(op):
    """hub password [set|off]: the page's password of this hub (core/pagepass.py) — the owner's, from the terminal: the
    way back when it is forgotten. Never as an argument (every account of the machine reads command lines): `set` asks
    for it twice, or reads two lines from a pipe."""
    from core import i18n, pagepass
    if ME or OUTSIDER:
        sys.exit(i18n.t("cli.pass.owner_terminal"))
    from core import instance
    cmd = instance.command_name(instance.name())   # `hub` of the main hub, `hub-<name>` of another one
    if op is None:
        print(i18n.t({"open": "cli.pass.status_open", "password": "cli.pass.status_password", "key": "cli.pass.status_key",
                      "broken": "cli.pass.status_broken"}[pagepass.state()], cmd=cmd))
    elif op == "off":
        print(i18n.t("cli.pass.off") if pagepass.take_off() else i18n.t("cli.pass.status_open", cmd=cmd))
    else:
        if sys.stdin.isatty():
            import getpass
            first, again = getpass.getpass(i18n.t("cli.pass.ask")), getpass.getpass(i18n.t("cli.pass.again"))
        else:
            first, again = (sys.stdin.readline().rstrip("\r\n") for _ in range(2))
        if first != again:
            sys.exit(i18n.t("cli.pass.differ"))
        why = pagepass.fits(first)
        if why:
            sys.exit(i18n.t(why, min=pagepass.MIN_LEN, max=pagepass.MAX_LEN))
        pagepass.set_password(first)
        print(i18n.t("cli.pass.set"))


def main(argv):
    global ARGV
    from core import i18n   # one import for the whole function: an import in a branch would make i18n local and unbound elsewhere
    if not argv or argv[0] in ("-h", "--help", "help"):   # hub help <command…> is hub <command…> --help
        print(usage([w for w in argv[1:] if w not in ("-h", "--help")]))
        return
    if argv == ["--version"]:   # what a program's version is asked with elsewhere
        argv = ["version"]
    ARGV = list(argv)
    cmd, rest = argv[0], argv[1:]
    from core import liaison as _liaison
    if ME == _liaison.NAME and cmd not in (*_liaison.COMMANDS, "contacts") and not _liaison.closes_form(argv):
        # the hub bus's liaison reads another hub's words: its commands are the bus's (core/liaison.COMMANDS, the same
        # list as its guard); local ones (a browser, a file copy) never reach the core's checks. `hub contacts` refuses
        # it itself, with its own reason (not_for_liaison)
        from core import i18n
        sys.exit(i18n.t("cli.bus.liaison_closed", cmd=cmd))
    if cmd == "session" and rest[:1] == ["fork"]:   # old skills and habit (there have been no forks since 04.10)
        sys.exit(i18n.t("cli.session.forks_gone"))
    # help on a subcommand is help, not a fact for the core (30.09: "hub session new --help" asked for a session named
    # "--help"); for commands with free text "--help" may be part of the text but not all of it (13.10: "hub decided
    # --help" recorded the decision "--help" for the owner); `hub direction <slug> --help` is the direction backlog help
    # (17.10: a skill says "--help — the list", but this one was shown)
    backlog_help = False
    if cmd == "direction" and rest[1:2] in (["-h"], ["--help"]):
        from modules.directions import direction
        try:   # no such direction (or a reserved word): the general help, as before
            backlog_help = bool(direction.home(rest[0]))
        except Exception:
            pass
    # help as the last word of a command with help is help, never the action (05.11, review: `hub session stop maps-1
    # --help` stopped maps-1); in the first two words — as before, except free text; inside free text it is a word
    # ("hub task note d1 fixed --help in the CLI"); a module's command and a backlog read their own last word
    last = rest[-1:] in (["-h"], ["--help"]) and cmd != "direction" and cmd in core_commands()
    if cmd in ("send", "notify", "decided", "close-ready", "answer", "deny"):
        asked = last
    elif cmd == "run":   # the words are a command: `hub run ls -h` runs ls -h; help — hub run --help, hub run list --help
        asked = rest[:1] in (["-h"], ["--help"]) or (rest[:1] in (["list"], ["stop"]) and last)
    else:
        asked = last or any(a in ("-h", "--help") for a in rest[:2])
    if rest in (["-h"], ["--help"]) or not backlog_help and asked:
        print(usage())
        return
    unknown_flags(cmd, rest)
    if cmd == "session" and rest[:1] == ["new"] and len(rest) >= 2 and not reducer.NAME.fullmatch(rest[1]):
        sys.exit(i18n.t("cli.session.name_bad", name=rest[1]))
    if cmd == "session" and rest[:1] == ["new"] and len(rest) >= 2:
        args, opts = rest[2:], {}
        for flag in ("--cwd", "--mode", "--about", "--icon"):
            opts[flag], args = value_of(args, flag)
        if opts.get("--mode") not in (None, "bypassPermissions"):
            from core import codexmodel, coretext
            from hosts import codex_rules
            # EXPERIMENT (exp/codex-parity): on Codex only the modes it can hold (approval policy and sandbox)
            if codexmodel.on_codex(STATE) and opts["--mode"] not in codex_rules.MODES:   # in the reader's language
                sys.exit(str(coretext.human(codex_rules.MODE_UNKNOWN.format(mode=opts["--mode"]))))
        agent = "--agent" in args
        args = [a for a in args if a != "--agent"]
        # no folder named: the session's own folder, not a shared one (core/workspace.py, owner decision 2026-10-08)
        cwd = opts.get("--cwd") or workspace.path(STATE, rest[1])
        # from a working session this is a request to the hub (the core turns it into a message to the hub with the task)
        put("session.requested", rest[1], {"cwd": os.path.abspath(cwd), "session_id": str(uuid.uuid4()),
                                           "mode": opts.get("--mode"), "task": " ".join(args) or None,
                                           "role": "agent" if agent else None, "about": opts.get("--about"),
                                           "icon": opts.get("--icon")})
    elif cmd == "session" and rest[:1] == ["rename"] and len(rest) == 3:
        put("session.renamed", rest[1], {"to": rest[2]})
    elif cmd == "session" and rest[:1] == ["role"] and len(rest) >= 2:
        args, opts = rest[2:], {}
        for flag in ("--about", "--icon", "--for"):
            opts[flag], args = value_of(args, flag)
        put("session.role_set", rest[1], {"role": args[0] if args else None, "about": opts.get("--about"),
                                          "icon": opts.get("--icon"),
                                          **({"for": opts["--for"]} if opts.get("--for") else {})})
    elif cmd == "session" and rest[:1] == ["icon"] and len(rest) == 3:
        put("session.iconed", rest[1], {"icon": None if rest[2] == "--clear" else rest[2]})
    elif cmd == "layout":
        layout_cmd(rest)
    elif cmd == "session" and rest[:1] == ["kit"]:
        # a session's skills and MCP: loaded against really used, or the whole hub's (core/kitcli.py; the page's data)
        from core import kitcli, uses
        days, words = value_of(rest[1:], "--days")
        fleet, as_json = "--fleet" in words, "--json" in words
        words = [w for w in words if w not in ("--fleet", "--json")]
        if (days is not None and days not in uses.PERIODS) or len(words) > (0 if fleet else 1) or not (fleet or words or ME) \
                or any(w.startswith("-") for w in words):   # a second --days, a flag of another case
            sys.exit(usage(["session", "kit"]))
        name = words[0] if words else ME
        st = current()
        got = kitcli.answer(STATE, st["sessions"], name, uses.PERIODS[days or "7"], fleet=fleet)
        if got is None:
            sys.exit(i18n.t("cli.send.no_session", name=name))
        tz = (st.get("owner") or {}).get("tz")
        print(json_text(got) if as_json else "\n".join((kitcli.fleet if fleet else kitcli.session)(got, tz)))
    elif cmd == "session" and rest[:1] == ["close"] and len(rest) == 2:
        put("session.close_requested", rest[1])
    elif cmd == "session" and rest[:1] == ["remove"] and len(rest) >= 2:
        for name in rest[1:]:
            put("session.remove_requested", name, {})
    elif cmd == "session" and rest[:1] == ["effort"] and len(rest) in (2, 3):
        # session reasoning level: `hub session effort <name> <level>`; from a session for itself, `hub session effort <level>`
        name, level = (rest[1], rest[2]) if len(rest) == 3 else (ME, rest[1])
        if not name:
            sys.exit(i18n.t("cli.session.effort_whom"))
        put("session.effort_set", name, {"level": level})
    elif cmd == "session" and rest[:1] == ["cwd"] and len(rest) == 3:
        # the folder moved: `hub session cwd <name> <folder>`; first move the folder, then tell the core (owner or hub)
        path = os.path.abspath(os.path.expanduser(rest[2]))
        if not os.path.isdir(path):
            sys.exit(i18n.t("cli.session.cwd_missing", path=path))
        put("session.cwd_set", rest[1], {"cwd": path})
    elif cmd == "session" and rest[:1] == ["model"] and len(rest) in (2, 3):
        # session model: `hub session model <name> <model>`; from a session for itself, `hub session model <model>`
        name, model = (rest[1], rest[2]) if len(rest) == 3 else (ME, rest[1])
        if not name:
            sys.exit(i18n.t("cli.session.model_whom"))
        put("session.model_set", name, {"model": codex_model(model)})
    elif cmd == "session" and rest[:1] == ["parallel"] and len(rest) == 3:
        # own executor count of a specialist or direction (owner, hub, agent-dev): 0 means "self" with the old event
        # session.solo_set (an old core after a rollback knows it), a number >= 1 and default use session.parallel_set
        arg = rest[2]
        ev = minihub.own_event("default" if arg == "default" else int(arg) if arg.isascii() and arg.isdigit() and len(arg) <= 3 else None)
        if not ev:
            sys.exit(i18n.t("cli.session.parallel_usage", max=minihub.OWN_MAX))
        seq = put(ev[0], rest[1], ev[1])
        # a number >= 1 does not lift "solo" by folder (06.11: the hub set it on the owner's "become a mini-hub", the
        # core said only "accepted", the direction stayed solo): say it, and how to fix it
        sess = current()["sessions"].get(rest[1]) or {}
        why = {v: k for k, v in minihub.AUTO.items()}.get(sess.get("solo_auto"))
        if why and ev[0] == "session.parallel_set" and seq not in REJECTED:   # also when only spooled: the folder is
            if why == "empty":                                                 # what it is either way
                print(i18n.t("cli.session.parallel_solo_empty", name=rest[1],
                             cwd=sess.get("cwd") or "<folder>"))
            else:
                print(i18n.t("cli.session.parallel_solo", name=rest[1], why=i18n.t("cli.session.solo_auto_none")
                             if why == "none" else i18n.t("cli.session.solo_auto_gone")))
    elif cmd == "session" and rest[:1] == ["solo"] and len(rest) == 3:
        # "self" (a synonym of hub session parallel <name> 0): works by itself, without executors; off clears "self"
        if rest[2] not in ("on", "off"):
            sys.exit(i18n.t("cli.session.solo_usage"))
        put("session.solo_set", rest[1], {"on": rest[2] == "on"})
    elif cmd == "session" and rest[:1] == ["compact"] and len(rest) <= 2:
        # compact the conversation (/compact): `hub session compact <name>`; from a session for itself, `hub session compact`
        name = rest[1] if len(rest) == 2 else ME
        if not name:
            sys.exit(i18n.t("cli.session.compact_whom"))
        put("session.compact_requested", name, {})
    elif cmd == "session" and rest[:1] == ["stop"] and len(rest) >= 2:
        for name in rest[1:]:   # an executor right now: abort the turn, stop it, put it to sleep (owner or hub)
            put("session.stop_requested", name, {})
    elif cmd == "session" and rest[:1] == ["interrupt"] and len(rest) >= 2:
        for name in rest[1:]:   # abort the current turn of any session, like Stop on the page; the session stays
            put("session.interrupt_requested", name, {})
    elif cmd == "session" and rest[:1] == ["wake"] and len(rest) >= 2:
        args, about = rest[2:], None
        if args[:1] == ["--about"] and re.fullmatch(r"d\d+", args[1] if len(args) > 1 else ""):
            # rework of task dN (a mini-hub wakes its executor only this way, with text); if not dN, plain words, as before
            about, args = args[1], args[2:]
            if not args:
                about = None   # without text: an ordinary wake-up, as before
                st = current()
                sleeper = st["sessions"].get(rest[1]) or {}
                from core import executors
                if ME and sleeper.get("raised_by") == ME and minihub.on(st, st["sessions"].get(ME)) \
                        and executors.dormant(sleeper):
                    sys.exit(i18n.t("cli.session.wake_needs_text", name=rest[1]))   # the core refuses without text
        if args[:1] == ["--file"] or args == ["-"]:   # the text from a file or stdin, as for hub send (13.11: sessions
            args = text_words(args)                   # gave a wake --file and got a refusal)
        taken = None
        if args and not about and ME:   # a mini-hub reworks only its own task: the one it gave this executor, if one
            about = taken = own_rework(current(), rest[1])
        if args:   # with a job: wake and hand the task at once (an executor that handed in: owner, hub or its mini-hub)
            seq = put("message.received", None, {"to": rest[1], "text": " ".join(args), "wake": True,
                                                 **({"about": about} if about else {})})
            if taken and seq not in REJECTED:   # also when only spooled: the task is named either way
                print(i18n.t("cli.session.wake_about_taken", name=rest[1], task=taken))
            queued_note(rest[1], seq)
        else:
            put("session.wake_requested", rest[1])
    elif cmd == "session" and rest[:1] == ["reload"] and len(rest) == 2:
        put("session.reload_requested", rest[1])
    elif cmd == "session" and rest[:1] == ["revive"] and len(rest) == 2:
        from core import coretext, guards
        old = current()["sessions"].get(rest[1]) or sys.exit(i18n.t("cli.no_session", name=rest[1]))
        if old["state"] not in guards.REVIVABLE:
            sys.exit(i18n.t("cli.session.revive_not_removed", name=rest[1], state=old['state']))
        data = {"session_id": old["session_id"], "cwd": old["cwd"], "revive": True}
        # the core decides who may and whether there is a place for the raiser (guards.revives, reducer._raiser_revives);
        # here the same questions, before the working copy is restored for a caller the core would refuse afterwards
        asked = {**speaker("session.requested", data), **reducer._target(current(), old)}
        why = guards.revives(current(), asked) or (
            reducer.revive_wait(current(), old, ME, time.time()) if guards.raiser_revives(current(), asked) else None)
        if why:
            sys.exit(coretext.human(why))
        wt = old.get("worktree") or {}
        if wt.get("path"):  # the working copy was removed on leaving: restore it to the same place
            from core import instance
            from hosts import worktree
            # several hubs on one machine: the copy gets this hub's mark, git takes the repo's lock across the hubs
            try:
                machine = instance.machine(STATE)
            except (OSError, ValueError):
                machine = {"owner": None, "others": []}
            owner = machine["owner"]
            foreign = lambda p: instance.live_in(machine["others"], p, worktree.in_tree)  # noqa: E731 — read under the lock
            try:
                with worktree.repo_lock(worktree.lock_target(wt.get("repo"), owner), 120):
                    ok, why = worktree.restore(wt, owner=owner, foreign=foreign if owner else None)
            except TimeoutError:
                ok, why = False, worktree.LOCK_BUSY.format(seconds=120)
            print(f"{rest[1]}: {coretext.human(why)}")   # the core's phrase: in the language of whoever reads
            if ok:
                data["worktree"] = reducer.revive_worktree(old)
        put("session.requested", rest[1], data)
    elif cmd == "slash":
        # a repo scaffold is run only by human input (disable-model-invocation): the session asks the core to type it for it
        if not ME:
            sys.exit(i18n.t("cli.slash.from_session"))
        if not rest or not rest[0].startswith("/"):
            sys.exit(i18n.t("cli.slash.needs_slash"))
        put("message.received", None, {"to": ME, "text": " ".join(rest), "slash": True})
    elif cmd == "send" and "--fyi" in rest and any(f in rest for f in ("--now", "--for", "--about", "--card")):
        sys.exit(i18n.t("cli.send.fyi_plain"))
    elif cmd == "send" and "--about" in rest:   # an addition to a task goes to whoever is doing it
        now = "--now" in rest   # urgent, as in the ordinary branch: the flag must not end up in the text
        about, words = value_of([w for w in rest if w != "--now"], "--about")
        usage_line = i18n.t("cli.send.usage_about")
        if not words:
            sys.exit(usage_line)
        busy_note(put("message.received", None, {"to": words[0], "text": text_or_exit(words[1:], usage_line),
                                                 "about": about, **({"now": True} if now else {})}))
    elif cmd == "send" and "--for" in rest:   # the owner's words to the hub, passed to a session (an answer to its card)
        now = "--now" in rest   # urgent, as in the ordinary branch: the flag must not end up in the text
        mid, words = value_of([w for w in rest if w != "--now"], "--for")
        card, words = value_of(words, "--card")   # which card they answered, when the session has several
        usage_line = i18n.t("cli.send.usage_for")
        if len(words) < 2:
            sys.exit(usage_line)
        text = text_or_exit(words[1:], usage_line, owner_words=True)
        busy_note(put("message.received", None, {"to": words[0], "text": text, "for": mid,
                                                 **({"card": card} if card else {}), **({"now": True} if now else {})}))
    elif cmd == "send" and "--to" in rest:   # a request to the bus's liaison about a contact (spec hubbus §5.13)
        from core import buscli, liaison
        to, words = value_of([w for w in rest if w not in ("--now", "--fyi")], "--to")
        thread, words = value_of(words, "--thread")   # the thread the words answer in (several matters with one hub)
        if len(words) > 1 and words[0] == liaison.NAME:   # `-` and `--file PATH` give the text, as in the ordinary hub send
            words = [words[0], text_or_exit(words[1:], i18n.t("cli.bus.request_usage"))]
        sys.exit(buscli.main(["request", "--to", to, *(["--thread", thread] if thread else []), *words], put, current,
                             STATE, me=ME, outsider=OUTSIDER, rejected=REJECT_WHY))
    elif cmd == "send" and len(rest) >= 2:
        now = "--now" in rest   # urgent, without the queue: hub or owner (owner decision 2026-10-09)
        fyi = "--fyi" in rest   # for information: does not wake and does not start a turn; arrives with its next turn
        rest = [w for w in rest if w not in ("--now", "--fyi")]
        text = text_or_exit(rest[1:], i18n.t("cli.send.usage_plain"))
        # the addressee is known in advance: if there is no such session, an error with a hint at once, not "accepted" (bus 03.10)
        from core import identity
        st = current()
        name = identity.resolve(st, rest[0]) or (rest[0] if rest[0].casefold() in identity.HUB_WORDS else None)
        if not name:
            live = sorted(n for n, x in st["sessions"].items() if x["state"] not in ("removed", "closed", "failed"))
            near = [n for n in live if rest[0].split("-")[0] in n][:5]
            sys.exit(i18n.t("cli.send.to_unknown_near", name=rest[0], near=', '.join(near)) if near else
                     i18n.t("cli.send.to_unknown", name=rest[0]))
        tgt = st["sessions"].get(name) or {}
        if ME and tgt.get("state") in ("removed", "closed", "failed") and tgt.get("kind") != "hub":
            sys.exit({"removed": i18n.t("cli.send.to_removed", name=name), "closed": i18n.t("cli.send.to_closed", name=name),
                      "failed": i18n.t("cli.send.to_failed", name=name)}[tgt["state"]])
        if not fyi and tgt.get("state") == "dialog" and any(r.get("tool") == "AskUserQuestion"
                                                            for r in tgt.get("pending") or []):
            print(i18n.t("cli.send.to_form_wait", name=name))
        # to one's own executor asleep after its hand-in a message does not go (the core refuses: it would come back to
        # the sender): with one task of the sender's it handed in, it is that task's rework, as hub session wake --about
        own = None if fyi else own_rework(st, name)
        seq = put("message.received", None, {"to": rest[0], "text": text, **({"wake": True, "about": own} if own else {}),
                                             **({"now": True} if now else {}), **({"fyi": True} if fyi else {})})
        if own and seq not in REJECTED:
            print(i18n.t("cli.send.own_sleeper_woken", name=name, task=own))
            queued_note(name, seq)
        if fyi and seq not in REJECTED:   # refused (the reason is printed, code 1): nothing to claim about its delivery
            # who actually got it: the core may have passed it to another (an executor that handed in, the mini-hub bus)
            msg = current()["messages"].get(f"m{seq}") or {}
            got = msg.get("session") or name
            redirect = i18n.t("cli.send.fyi_redirect", name=name) if got != name else ""
            if msg.get("fyi_woke") and msg.get("state") != "failed":   # it waits for the owner: delivered as an ordinary one
                from core import i18n
                print(i18n.t("cli.send.fyi_woke", name=got) + redirect)
            else:
                print(i18n.t("cli.send.fyi_later", name=got) + redirect)
        elif not own:
            busy_note(seq)
    elif cmd == "answer" and len(rest) >= 2:
        answer(rest[0], rest[1:])
    elif cmd == "allow" and len(rest) == 1:
        put("permission.answered", rest[0], {"request_id": pending_or_exit(rest[0])["request_id"], "behavior": "allow"})
    elif cmd == "deny" and len(rest) >= 1:
        put("permission.answered", rest[0], {"request_id": pending_or_exit(rest[0])["request_id"], "behavior": "deny",
                                             "message": " ".join(rest[1:]) or None})
    elif cmd == "take" and len(rest) == 1:
        take(rest[0])
    elif cmd == "away" and "--status" in rest:
        st = current()
        o = st.get("owner") or {}
        if o.get("state") == "away":
            until = o.get("until")
            from core import deputycli, owner
            print(i18n.t("cli.away.status_until", time=owner._local(until, o.get('tz') or 'UTC').strftime('%H:%M')) if until
                  else i18n.t("cli.away.status_open"))
            for line in deputycli.away_lines(st, status=True):   # the deputies of this away and their cards (d2679763)
                print(line)
        else:
            print(i18n.t("cli.away.status_no"))
    elif cmd == "away":
        hours, words = value_of(rest, "--hours")
        ref, words = value_of(words, "--for")
        data = {"hours": positive(hours, "--hours") if hours is not None else None, **({"for": ref} if ref else {})}
        if "--deputies" in words:   # all deputies, or the ones named after the flag (core/deputies.py, spec d2679763)
            names = [w for w in words[words.index("--deputies") + 1:] if not w.startswith("--")]
            data["deputies"] = names or True
        seq = put("owner.away", None, data)
        if "deputies" in data and seq is not None and seq not in REJECTED:
            from core import deputycli
            for line in deputycli.away_lines(current()):
                print(line)
    elif cmd == "back":
        put("owner.back", None, {})
    elif cmd == "post" and len(rest) >= 2:  # plugin channel (API 1.2): a post in your name
        reply, words = value_of(rest[1:], "--reply")
        text = text_or_exit(words, i18n.t("cli.post.usage_line"))
        put("ext.post", None, {"plugin": rest[0], "text": text, **({"reply_to": reply} if reply else {})})
    elif cmd == "feed" and rest:  # read a plugin channel: the latest posts, replies marked with ↳
        last, _ = value_of(rest, "--last")
        n = positive(last, "--last", int) if last is not None else 30
        posts = (current().get("feeds") or {}).get(rest[0]) or []
        if not posts:
            print(i18n.t("cli.feed.channel_empty", channel=rest[0]))
        for p in posts[-n:]:
            at = datetime.datetime.fromtimestamp(p["ts"]).strftime("%d.%m %H:%M")
            who = i18n.t("cli.feed.by_owner") if p["by"] == "owner" else p["by"]
            print(f"{p['id']} · {who} · {at}" + (f" · ↳ {p['reply_to']}" if p.get("reply_to") else "") + f"\n  {p['text']}")
    elif cmd == "waiting":  # what the session is waiting for (owner decision 2026-10-03: "free" says nothing useful)
        name, words = (ME, rest) if ME else (rest[0] if rest else None, rest[1:])
        # the hub clears another session's label from its own session: `hub waiting <session> --clear` (the name used to
        # come from HUB_SESSION, so the hub got "waiting: maps --clear" while maps kept its label). Text without quotes
        # stays the session's own words: "waiting for qa ..."
        if ME and rest[1:] == ["--clear"]:
            sessions = current()["sessions"]
            if (sessions.get(ME) or {}).get("kind") == "hub":
                if (sessions.get(rest[0]) or {}).get("state") in (None, "removed"):
                    sys.exit(f"no session {rest[0]}")
                name, words = rest[0], rest[1:]
        text = " ".join(text_words(words)).strip()
        if not name or not (text or words == ["--clear"]):
            sys.exit(i18n.t("cli.waiting.usage_line"))
        seq = put("session.waiting", name, {"clear": True} if words == ["--clear"] else {"text": text})
        if words != ["--clear"] and seq not in REJECTED:   # in the spool but not recorded: warn as well
            # "waiting" for a person or service without a check means nobody will catch the reply (owner decision
            # 2026-10-05); for a session or the owner the reply arrives by itself
            st, low = current(), text.lower()
            # owner and hub: by the word stem of every language with data (core/langdata.py), in English as a whole word:
            # "github" and "HubSpot" are not the hub; a session name may contain a dot (web.app), but a dot at the end of a
            # phrase is not part of the name
            from core import langdata
            tokens = {t.strip(".") for t in re.findall(r"[\w.-]+", low)}
            people = any(w in low for w in langdata.words("words", "people_stems")) or bool({"hub", "hubs", "owner"} & tokens) or any(
                n.lower() in tokens for n, x in st["sessions"].items() if n != name and x["state"] != "removed")
            from core import schedule
            checks = any(schedule.wakes(j, name) and j.get("state") == "active" for j in (st.get("schedule") or {}).values())
            if not (people or checks or (st["sessions"].get(name) or {}).get("background")):
                print(i18n.t("cli.waiting.nothing_checks"))
    elif cmd == "gist":  # the session's gist in one line under "Now"; the core cuts anything over 160 characters at a word
        name, words = (ME, rest) if ME else (rest[0] if rest else None, rest[1:])
        if ME and len(rest) == 2 and rest[0] != ME:   # the hub edits another session's gist: hub gist <session> "<…>" (two words)
            sessions = current()["sessions"]
            if (sessions.get(ME) or {}).get("kind") == "hub" \
                    and (sessions.get(rest[0]) or {}).get("state") not in (None, "removed"):
                name, words = rest[0], rest[1:]
        text = " ".join(text_words(words)).strip()
        if not name or not (text or words == ["--clear"]):
            sys.exit('hub gist "<what you did / need from the owner / are doing>" | --clear  (hub, owner: hub gist <session> "<…>")')
        put("session.gist", name, {"clear": True} if words == ["--clear"] else {"text": text})
    elif cmd == "attention":   # the session drops its own "waits for you" mark: its result needs nothing from the owner
        name = (rest[1] if len(rest) == 2 else ME) if rest[:1] == ["off"] and len(rest) <= 2 else None
        if not name:
            sys.exit('hub attention off  (hub, owner: hub attention off <session>) — drop your own "waits for you" mark: '
                     "this turn's result needs nothing from the owner")
        put("session.attention_off", name, {})
    elif cmd == "decided" and rest:
        # a lone command word or flag ("list", "undo 5", "--all") is a guess at a subcommand, not a decision: it was
        # recorded as one ("hub decided list" → the decision "list"); a phrase that merely starts with such a word stays,
        # and so does a short one ("Show thumbnails"): a second word counts only as a number or an id (5, m90, q41)
        card, rest = value_of(rest, "--card")   # on a deputy's answer: the card closes (core/deputyroute.py)
        rest = text_words(rest)   # `-` / `--file PATH`: the text as typed, not the word "-"
        if card and not " ".join(rest).strip():
            sys.exit(i18n.t("cli.decided.card_text"))
        words = " ".join(rest).split()
        # with --card no subcommand: the liaison may run only the close of its form (a "list" or "undo N" is refused
        # below as a guess), not the local read of the owner's decisions
        if words == ["list"] and not card:   # the last recorded decisions, a withdrawn one marked
            decisions = current().get("decisions") or []
            for d in decisions[-20:]:
                print(f"#{d['seq']} {time.strftime('%Y-%m-%d %H:%M', time.localtime(d['ts']))} {d.get('by') or '-'}: "
                      f"{' '.join(str(d.get('text') or '').split())}" + (f"  [{i18n.t('cli.decided.withdrawn')}]" if d.get("revoked") else ""))
            if not decisions:
                print(i18n.t("cli.decided.none"))
            return
        if len(words) == 2 and words[0] == "undo" and words[1].lstrip("#").isdigit() and not card:
            seq = put("owner.decided_revoked", None, {"seq": int(words[1].lstrip("#"))})
            if REJECT_WHY.get(seq) == "unknown event type":   # hubd started before this command existed
                print(i18n.t("cli.decided.old_core"))
            return
        guess = words and (words[0].casefold() in ("list", "ls", "show", "undo", "help")
                           or re.fullmatch(r"--?[A-Za-z][\w-]*", words[0]))
        if guess and (len(words) == 1 or len(words) == 2 and re.fullmatch(r"#?[a-z]?\d+", words[1])):
            sys.exit(i18n.t("cli.decided.reserved", word=words[0]))
        if card:   # on a deputy's answer: their addresses in the book now go with it (core/deputyroute.py)
            from core import deputycli
            card_data = {"card": card, **deputycli.card_address(current(), card)}
        put("owner.decided", None, {"text": " ".join(rest), **(card_data if card else {})})
    elif cmd == "notify" and rest[:1] == ["--resolve"] and len(rest) == 2:
        # the cause is gone: clear your own notification (push spec, §2.6); the banner on the phone disappears
        put("owner.notify_resolved", None, {"id": rest[1], "source": os.environ.get("HUB_SCHEDULE_JOB")})
    elif cmd == "notify" and rest:
        urgent = "--urgent" in rest
        title, words = value_of(rest, "--title")
        extra = {}
        for flag in ("--id", "--topic", "--urgency", "--due", "--session"):   # optional fields of the notification reason
            value, words = value_of(words, flag)
            if value is not None:
                extra[flag[2:]] = value
        push = "--no-push" not in words
        words = [w for w in words if w not in ("--urgent", "--no-push")]
        text = platforms.current.read_stdin() if words == ["-"] else " ".join(words)
        put("owner.notify", None, {"text": text.strip(), "title": title, "urgent": urgent, **extra,
                                   **({} if push else {"push": False}),
                                   "source": os.environ.get("HUB_SCHEDULE_JOB")})
    elif cmd == "question" and rest[:1] == ["withdraw"] and len(rest) in (2, 3):
        # withdraw a question to the owner qN: one's own (session) or any (hub); 07.10, a duplicate of one question from two sessions
        qid, why = rest[1], (rest[2] if len(rest) == 3 else "")
        put("question.withdrawn", asker_or_exit(qid), {"id": qid, "why": why})
    elif cmd == "question" and rest[:1] == ["route"] and len(rest) >= 3:
        # a card to a deputy of this away, or back to the owner (core/deputyroute.py, spec d2679763 A7)
        from core import deputycli
        qid, words = rest[1], rest[2:]
        note, words = value_of(words, "--note")
        sys.exit(deputycli.route(asker_or_exit(qid), qid, words, note, put, current, REJECT_WHY))
    elif cmd == "question" and rest[:1] == ["show"] and len(rest) == 2:
        # a session's question goes to the hub chat as the same card (12.10: the hub used to ask it again, leaving the owner two cards)
        if ME and (current()["sessions"].get(ME) or {}).get("kind") != "hub":   # to read a card use hub status (13.10)
            sys.exit(i18n.t("cli.question.show_by_hub"))
        put("question.shown", asker_or_exit(rest[1]), {"id": rest[1]})
    elif cmd == "codex":   # EXPERIMENT (exp/codex-main): the hub's Codex sign-in — core/codexcli
        from core import codexcli
        # the fact's seq, None — rejected or not recorded yet (put has printed why): the command does not say "done" then
        sys.exit(codexcli.main(rest, STATE, me=ME or OUTSIDER,
                               put=lambda *a, **k: (lambda seq: None if seq in REJECTED else seq)(put(*a, **k))))
    elif cmd == "version" and not rest:   # hub version; for a package also where to file issues
        from core import packaged
        data = packaged.info()
        if packaged.is_app(data):   # the app: the code is a git clone that updates (installer S3), the shell has its own version
            from core import catalog, i18n, version
            repo = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
            got = " · ".join(x for x in (version.release(repo, STATE), catalog._git_version(repo)) if x) or "?"
            from core import appcode, appwatch
            man = appwatch.manifest(repo) if appwatch.layer(repo) else None
            own = appcode.own_of(man)
            if man is not None:   # the code layer has no git: its manifest names the release and its whole commit
                got = " · ".join(str(x) for x in (man.get("version"), man.get("commit")) if x) or got
            if own:   # a build of the person's edits (`hub app apply`): the release it is over, + N
                got = i18n.t("cli.version.own_build", release=own.get("release") or "?", commit=own.get("commit") or "?",
                             count=own.get("edits") or 0, build=man.get("commit") or "?")
            print(i18n.t("cli.version.app", code=got, shell=data.get("version") or "?", runtime=data.get("runtime", "?"),
                         repo=repo))
            if man is not None:   # where issues go, and the core's working copy of the Hub Developer (core/ownsrc.py)
                from core import ownsrc
                url = packaged.issues_url(data) or packaged.issues_url(man)
                print(i18n.t("cli.version.issues", url=url) if url else i18n.t("cli.version.pkg_no_issues"))
                own = ownsrc.status(STATE)
                if own:
                    print(i18n.t("cli.version.own", path=own["path"], version=own.get("version") or "?",
                                 count=own.get("edits") or 0))
        elif data is None:
            from core import catalog, version
            repo = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
            # the release (tag vX.Y.Z) already in the code and the update channel (owner decision 2026-10-15)
            got = " · ".join(x for x in (version.release(repo, STATE), catalog._git_version(repo)) if x) or \
                i18n.t("cli.version.src_no_git")
            print(i18n.t("cli.version.src_line", version=got, channel=version.channel(catalog.load_config(STATE)), repo=repo))
        else:
            print(i18n.t("cli.version.pkg_line", format=data.get('format') or '', version=data.get('version') or '?')
                  + (i18n.t("cli.version.pkg_build", commit=data['commit']) if data.get("commit") else "")
                  + i18n.t("cli.version.pkg_code", path=os.path.dirname(os.path.dirname(os.path.realpath(__file__)))))
            url = packaged.issues_url(data)
            print(f"issues: {url}" if url else i18n.t("cli.version.pkg_no_issues"))
    elif cmd == "mcp" and rest[:1] == ["login"] and len(rest) >= 3 and \
            set(value_of(rest[3:], "--redirect")[1]) <= {"--no-browser", "--confirm"}:
        # a repo MCP waits for sign-in (OAuth): sign in without an interactive session (owner decision 2026-10-07):
        # `claude mcp login` in the session folder opens sign-in in the browser on Mac; once signed in, the core restarts
        # the sessions with this server in the same conversation
        name, server = rest[1], rest[2]
        redirect, opts = value_of(rest[3:], "--redirect")
        st = current()
        sess = session_or_exit(name, st)
        if mcp_login_core(st, name, server, redirect, "--no-browser" in opts, "--confirm" in opts):
            return   # through the core, as from the page (core/mcpwatch)
        from core import codexmodel
        if codexmodel.on_codex(STATE):   # EXPERIMENT (exp/codex-parity): the old way is claude's own login, and a Codex
            # session's server is its thread's own (hosts/codex_mcp) — only the core's way, through a live session
            from core import i18n
            sys.exit(i18n.t("cx_b.mcp_login_not_waiting", server=server, name=name))
        # the old way: claude mcp login needs a terminal (07.10): run it in a pseudo-terminal; it opens the sign-in in the owner's browser itself
        from core import mcplogin
        i18n.current()   # this process's language is settled while HUB_SESSION is still in the environment
        for k in ("HUB_SESSION", "CLAUDECODE"):
            os.environ.pop(k, None)
        # an MCP from the hub catalog runs from its own folder with its description (the session folder does not have it, 11.10)
        cwd = mcplogin.login_dir(STATE, name, server) or sess["cwd"]
        work = mcplogin.work_dir(STATE, server)
        if redirect:   # hub without a browser, step 2: the address from the person's browser bar goes to the waiting sign-in
            code, out = mcplogin.finish(work, redirect)
        elif "--no-browser" in opts or not mcplogin.has_browser():
            # a hub without a browser (server, 11.10): sign-in by link; the person signs in on their side and sends the return address
            url, why = mcplogin.start(server, cwd, work)
            if not url:
                sys.exit(i18n.t("cli.mcp.old_not_started", server=server, why=why))
            print(i18n.t("cli.mcp.old_link", server=server, url=url, name=name))
            return
        else:
            print(i18n.t("cli.mcp.old_signing_in", server=server), flush=True)
            code, out = mcplogin.login(server, cwd, run_dir=os.path.join(STATE, "mcp-login", "run"))
        if code != 0:
            sys.exit(i18n.t("cli.mcp.old_failed", server=server, out=out.strip()[-400:],
                            why=i18n.t("cli.mcp.old_timeout") if code == 124 else i18n.t("cli.mcp.old_code", code=code)))
        put("mcp.logged_in", name, {"server": server})
    elif cmd == "mcp" and rest[:1] == ["reconnect"] and len(value_of(rest[1:], "--session")[1]) == 1:
        # reconnect now (core/mcpwatch): the service is up again or the login went through elsewhere — the automatic
        # retry would come in up to 10 minutes; who may — as for hub mcp login
        name, words = value_of(rest[1:], "--session")
        if name:
            session_or_exit(name)
        seq = put("mcp.reconnect_requested", name, {"server": words[0]})
        st = current()
        asked = (st.get("mcp_reconnect_asked") or {}).get(words[0]) or {}
        if seq and seq not in REJECTED and asked.get("seq") == seq and asked.get("sessions"):
            from core import i18n
            print(i18n.t("cli.mcp.reconnecting", server=words[0], names=", ".join(asked["sessions"])))
            auth = [n for n in asked["sessions"]
                    if words[0] in ((st["sessions"].get(n) or {}).get("info") or {}).get("mcp_auth") or []]
            if auth:   # a reconnect does not log in (a needs-auth server comes up only if the login went through elsewhere)
                print(i18n.t("cli.mcp.reconnect_login", server=words[0], names=", ".join(auth)))
    elif cmd == "update" and rest[:1] == ["forget-follower"] and len(rest) in (2, 4):
        # the hub on this code folder is removed for good: its readiness entry no longer holds the update (modules/update/private)
        word, args = value_of(rest[1:], "--for")
        owner_gate("hub update forget-follower", word)
        from core import i18n
        from modules.update import private
        key = args[0] if len(args) == 1 else ""
        try:
            private.forget(private.tree(), key)
        except ValueError as e:
            sys.exit(f"hub update forget-follower: {e}")
        print(i18n.t("cli.update.forgot_follower", id=key))
    elif cmd == "update" and rest[:1] == ["lost"]:
        # the release's hunks a merge may have lost (modules/update/shadow.py, dev-guard spec §5.4): Hub Developer looks
        # and answers; the answer only takes a line off the band, so its own executors, the hub and the owner may give it
        from core import catalog, i18n
        from modules.update import shadow
        dev = (catalog.load_config(STATE).get("dev") or {}).get("name") or "hub-dev"
        if OUTSIDER:
            sys.exit(i18n.t("cli.update.lost_who", dev=dev))
        if ME:   # Hub Developer or its executor (the rule of verdict_gate), the hub
            me = current()["sessions"].get(ME) or {}
            if ME != dev and me.get("kind") != "hub" and not (minihub.runner(me) and me.get("raised_by") == dev):
                sys.exit(i18n.t("cli.update.lost_who", dev=dev))
        signals = shadow.open_signals(STATE)
        if len(rest) == 1:
            if not signals:
                print(i18n.t("cli.update.lost_none"))
            for s in signals:
                print(f"{s['id']}  {s.get('path', '')}  {s.get('hunk', '')}  ({str(s.get('release', ''))[:12]})")
                for line in s.get("lines") or []:
                    print(f"    {line}")
            sys.exit(0)
        if len(rest) != 3 or rest[1] not in shadow.WORDS:
            sys.exit(i18n.t("cli.update.lost_usage"))
        if rest[2] not in {s["id"] for s in signals}:
            sys.exit(i18n.t("cli.update.lost_unknown", id=rest[2][:20]))
        shadow.answer(STATE, rest[2], rest[1])
        print(i18n.t("cli.update.lost_recorded", id=rest[2]))
    elif cmd == "update" and rest[:1] == ["local-edits"]:
        # "Take off" / "Put back" of the hub's own edits of the core (modules/update/takeoff.py): the update process does it
        # under the machine lock; new code in the hub (or the old code back) is the owner's word, as module add
        from core import i18n
        word, args = value_of(rest[1:], "--for")
        if args not in (["off"], ["on"]):
            sys.exit(i18n.t("cli.update.local_edits_usage"))
        owner_gate("hub update local-edits", word)
        from modules.update.update import EDITS_FLAG, ask
        if os.path.exists(os.path.join(STATE, EDITS_FLAG)):
            sys.exit(i18n.t("cli.update.local_edits_pending"))
        ask(STATE, EDITS_FLAG, args[0])
        print(i18n.t("cli.update.local_edits_off") if args[0] == "off" else i18n.t("cli.update.local_edits_on"))
    elif cmd == "update" and (rest == [] or rest[:1] == ["rollback"] and len(rest) <= 2):
        # the app (core/packaged.py, format "app") updates by this command and the page button, and can go back to the
        # previous release; an older package does not update from here
        from core import i18n, packaged
        data = packaged.info()
        if rest[:1] == ["rollback"]:
            if not packaged.is_app(data):
                sys.exit(i18n.t("cli.update.rollback_not_app"))
            from modules.update.update import ROLLBACK_FLAG
            from core import appcode
            if len(rest) == 2 and not appcode.version_ok(rest[1], data.get("layout") == "layer"):
                sys.exit(i18n.t("cli.update.rollback_version"))
            flag = os.path.join(STATE, ROLLBACK_FLAG)
            with open(flag + ".part", "w") as f:   # the release expected: a repeat goes no further back; whole or not at all
                f.write(rest[1] if len(rest) == 2 else "")
            os.replace(flag + ".part", flag)
            print(i18n.t("cli.update.rollback_started"))
        else:
            if data is not None and not packaged.is_app(data):
                sys.exit(packaged.HOW)
            from modules.update.update import INSTALL_FLAG
            open(os.path.join(STATE, INSTALL_FLAG), "w").close()
            print(i18n.t("cli.update.started_app" if packaged.is_app(data) else "cli.update.started"))
    elif cmd in ("send-file", "send-rich") and set(rest) - {"--screenshot"}:  # files for the owner: to Telegram and the page feed (owner.file), one event per file
        # --screenshot: a screen capture from another tool (a hub shot frame says so in the file itself) — a file index
        # sorts it with the screenshots, not with generated pictures; the flag anywhere, it is not a word of the
        # caption; the flag alone is no command, like send-file without arguments. send-file only: a report is no
        # screen capture — send-rich's help has no such flag, so the flag check refuses it before this branch
        screenshot = cmd == "send-file" and "--screenshot" in rest
        if screenshot:
            rest = [w for w in rest if w != "--screenshot"]
        rich_title = None
        if cmd == "send-rich":   # a .md/.html report with pictures: in Telegram one rich message (telegram.rich)
            if "--title" in rest:
                at = rest.index("--title")
                rich_title = " ".join(rest[at + 1:at + 2]) or None
                rest = rest[:at] + rest[at + 2:]
            if not rest:
                sys.exit(misuse())
            rest = rest[:1]   # the pictures are named inside the report
        path = os.path.abspath(rest[0])
        if not os.path.isfile(path):
            sys.exit(i18n.t("cli.sendfile.missing", path=path))
        # 30.10: `send-file a b c` sent only a — the leading run of existing files is all files, the rest is the caption
        # (of the last file); a caption that happens to name a missing file stays a caption
        files, n = [path], 1
        while n < len(rest) and os.path.isfile(os.path.abspath(rest[n])):
            files.append(os.path.abspath(rest[n]))
            n += 1
        caption = " ".join(rest[n:]) or rich_title
        # as a copy into attachments: the session may delete the source, while the file stays in the feed and Telegram (19.10)
        from core import catalog
        from modules.web import attach
        try:
            limit = attach.max_bytes(catalog.load_config(STATE))
        except ValueError:   # hub.json with an error: the default limit, not a refusal to send
            limit = attach.max_bytes({})
        media = {}   # send-rich: the pictures of the report are kept too (the session may delete the folder before the bot sends)
        if cmd == "send-rich":
            from modules.telegram import rich
            if not rich.is_report(path):
                cmd = "send-file"   # not a report: an ordinary file
            else:
                try:
                    for _, pic, _ in rich.build(path).files:
                        kept_pic = attach.keep(STATE, pic, limit)
                        if kept_pic:
                            media[pic] = kept_pic
                except OSError:
                    pass   # unreadable: the bot sends it as a file
        for i, path in enumerate(files):
            kept = attach.keep(STATE, path, limit)
            if kept is None:
                print(f"no copy kept (over {limit >> 20} MB or the copy failed): the owner gets a link to {path} — "
                      f"do not delete it")
            seq = put("owner.file", None, {"path": kept or path, "caption": caption if i == len(files) - 1 else None,
                                           **({"source": path} if kept and kept != path else {}),
                                           **({"rich": True, "title": rich_title, **({"media": media} if media else {})} if cmd == "send-rich" else {}),
                                           **({"screenshot": True} if screenshot else {})})
            if seq in REJECTED and kept and kept != path:   # the core did not accept it: the copy belongs to no one
                import shutil
                shutil.rmtree(os.path.dirname(kept), ignore_errors=True)
    elif cmd == "shot":  # screenshot of the result with markup, before/after (modules/proof)
        from modules.proof import shot
        sys.exit(shot.main(rest, os.path.join(STATE, "proof")))
    elif cmd == "video":  # a scenario video up to 60 s: a module, turned on by hand (modules/proof)
        from core import catalog
        from modules.proof import video
        sys.exit(video.main(rest, catalog.load_config(STATE), os.path.join(STATE, "proof")))
    elif cmd == "accounts" and cutout_present("profile"):  # Claude accounts for the hub (modules/accounts)
        from core import catalog, profiles
        st = current()
        # a switch by the owner's or the hub's word is written by the core through the sessions' sign-in (core/profiles.py); the rest is the pool
        code = profiles.cli_use(rest, st, put, ME or OUTSIDER, catalog.config_path(STATE), state_dir=STATE)
        if code is not None:
            sys.exit(code)
        from modules.accounts import accounts
        sys.exit(accounts.main(rest, st, put, ME or OUTSIDER, catalog.config_path(STATE), state_dir=STATE))
    elif cmd == "conduit" and cutout_present("conduit"):  # spare Claude account from conduit (modules/conduit); on/off by the owner or the hub
        from modules.conduit import conduit
        if rest[:1] in (["on"], ["off"], ["token"], ["watch"]) and (ME or OUTSIDER) and (current()["sessions"].get(ME or "") or {}).get("kind") != "hub":
            print(i18n.t("cli.hub.owner_or_hub"))
            sys.exit(1)
        sys.exit(conduit.main(rest))
    elif cmd == "stats" and cutout_present("stats"):  # hub statistics (modules/stats): what will be sent, what was sent; on/off by the owner or the hub
        from modules.stats import stats
        if rest[:1] in (["on"], ["off"], ["watch"]) and (ME or OUTSIDER) and (current()["sessions"].get(ME or "") or {}).get("kind") != "hub":
            print(i18n.t("cli.hub.owner_or_hub"))
            sys.exit(1)
        sys.exit(stats.main(rest, STATE))
    elif cmd == "remote" and rest[:1] == ["cloudflare"]:   # remote access through Cloudflare (modules/cloudflare): owner or hub
        from core import i18n
        from modules.cloudflare import cli as cloudflare
        if rest[1:2] in (["setup"], ["remove"], ["rotate"]) and (ME or OUTSIDER):
            sys.exit(i18n.t("cloudflare.setup.only_terminal"))   # the owner's API token never passes through a session
        if rest[1:2] != ["status"] and rest[1:] and (ME or OUTSIDER) \
                and (current()["sessions"].get(ME or "") or {}).get("kind") != "hub":
            sys.exit(i18n.t("cloudflare.cli.only_owner"))
        sys.exit(cloudflare.main(rest[1:], STATE))
    elif cmd == "perms" and rest == ["restore"]:   # earlier permissions of hub folders (core/perms.py): owner or hub
        from core import i18n
        if (ME or OUTSIDER) and (current()["sessions"].get(ME or "") or {}).get("kind") != "hub":
            sys.exit(i18n.t("cli.perms.only_owner"))
        print(i18n.t("cli.perms.restored", count=perms.open_up(STATE, _catalog.config_path(STATE))))
    elif cmd == "journal" and rest[:1] == ["scrub"] and set(rest[1:]) <= {"--apply", "--backup"}:
        # keys of the previous hub in journals (core/scrub.py): only by this command, owner or hub
        from core import i18n, scrub
        if (ME or OUTSIDER) and (current()["sessions"].get(ME or "") or {}).get("kind") != "hub":
            sys.exit(i18n.t("cli.scrub.only_owner"))
        apply, backup = "--apply" in rest, "--backup" in rest
        n, dirty = scrub.live(STATE)
        if n or dirty:
            print(i18n.t("cli.scrub.live", count=n) if n else i18n.t("cli.scrub.live_state"))
        settle = {}

        def ask():   # hubd is running: it rotates; if it refused, False; if the record did not arrive in time, still wait for the rotation
            put("journal.scrub_requested")
            return not REJECTED
        if apply and (n or dirty):
            rotated, archived = scrub.rotate_live(STATE, ask)
            if not rotated:   # an older hubd, or one busy past the deadline: its late rotation must not catch the rewrite
                sys.exit(i18n.t("cli.scrub.not_rotated"))
            print(i18n.t("cli.scrub.rotated"))
            settle = {name: time.time() + scrub.SETTLE for name in archived}   # readers finish them by inode
        short = []

        def no_space(path, need):   # the archive was skipped: the next run will take it again
            short.append(path)
            print(i18n.t("cli.scrub.no_space", name=os.path.basename(path), mb=need >> 20))
        found = scrub.run(STATE, apply=apply, backup=backup, no_space=no_space, settle=settle, say=lambda path, k: print(
            i18n.t("cli.scrub.archive", name=os.path.basename(path), count=k)))
        cleaned = [f for f in found if f[0] not in short]
        if not found and not (n or dirty):
            print(i18n.t("cli.scrub.none"))
        elif not apply:
            print(i18n.t("cli.scrub.found", count=sum(k for _, k in found) + n))
        elif cleaned:
            print(i18n.t("cli.scrub.cleaned", count=len(cleaned))
                  + (" " + i18n.t("cli.scrub.backup", path=os.path.join(STATE, "backup")) if backup else ""))
        if short:
            sys.exit(1)
    elif cmd == "journal" and rest[:1] == ["compact"] and set(rest[1:]) <= {"--apply", "--backup"}:
        # archives an earlier hub wrote whole (journal.compact_archives): only by this command, owner or hub
        from core import i18n
        if (ME or OUTSIDER) and (current()["sessions"].get(ME or "") or {}).get("kind") != "hub":
            sys.exit(i18n.t("cli.compact.only_owner"))
        apply, backup = "--apply" in rest, "--backup" in rest
        short = []

        def no_space(path, need):   # the archive was skipped: the next run will take it again
            short.append(path)
            print(i18n.t("cli.scrub.no_space", name=os.path.basename(path), mb=need >> 20))
        def failed(path, error):
            short.append(path)
            print(i18n.t("cli.compact.failed", name=os.path.basename(path), error=error))
        backup_dir = os.path.join(STATE, "backup", time.strftime("compact-%Y%m%d-%H%M%S")) if backup and apply else None
        if apply and not backup:   # the archives are rewritten in place: there is no way back
            print(i18n.t("cli.compact.no_backup"), file=sys.stderr)
        found = journal.compact_archives(STATE, apply=apply, backup_dir=backup_dir, no_space=no_space, failed=failed)
        for path, before, after in found:
            print(i18n.t("cli.compact.archive", name=os.path.basename(path), before=before >> 20, after=after >> 20))
        before, after = sum(f[1] for f in found), sum(f[2] for f in found)
        if not found and not short:
            print(i18n.t("cli.compact.none"))
        elif not apply:
            print(i18n.t("cli.compact.found", before=before >> 20, after=after >> 20, free=(before - after) >> 20))
        elif found:
            print(i18n.t("cli.compact.done", count=len(found), free=(before - after) >> 20)
                  + (" " + i18n.t("cli.compact.backup", path=backup_dir) if backup_dir else ""))
        if short:
            sys.exit(1)
    elif cmd == "modules" and rest[:1] == ["reset"] and len(rest) == 2:   # core modules (core/modules.py)
        put("module.reset", rest[1], {"module": rest[1]})
    elif cmd == "modules" and rest[:1] == ["forget"] and len(rest) == 2:   # core.write: clear the page warning
        put("module.forget", rest[1], {"module": rest[1]})
    elif cmd == "modules" and rest[:1] == ["touched"] and len(rest) in (2, 4) and (len(rest) == 2 or rest[2] == "--days"
                                                                                 and rest[3].replace(".", "", 1).isdigit()):
        from core import corewrite   # what a module with core.write changed and where it is now
        print("\n".join(corewrite.touched(STATE, rest[1], current(), days=float(rest[3]) if len(rest) == 4 else 7)))
    elif cmd == "modules" and rest in ([], ["--json"]):
        from core import catalog, corewrite, modules
        try:
            cfg = catalog.load_config(STATE)
        except ValueError as e:
            sys.exit(i18n.t("cli.modules.config_broken", error=e))
        st = current()
        table = modules.rows(cfg, STATE, st)
        marks = corewrite.marks(st, cfg)   # modules that wrote to the core state (core.write)
        for r in table:
            if r["name"] in marks:
                r["core_written"] = marks[r["name"]]
        from core import providers   # who handles session sign-in, voice, the report: built-in or a module (shadow)
        from modules.update import private   # private modules: installed, or why not
        print(json_text(table) if rest else
              "\n".join([modules.text(table)] + ["! " + w for w in corewrite.warnings(st, cfg)]
                        + providers.lines(st.get("providers")) + private.lines(STATE)))
    elif cmd == "secret":  # a secret from the hub's vault into a form field or a command's environment (modules/secrets)
        from core import catalog
        from modules.secrets import cli
        sys.exit(cli.main(rest, catalog.load_config(STATE), ME, cli.post(web_port(platforms.current.service_unit(STATE))),
                          state=STATE, put=put))
    elif cmd == "critic":  # a critic from another model before an important decision: an option (modules/critic)
        from core import catalog
        from modules.critic import critic
        sys.exit(critic.main(rest, catalog.load_config(STATE), account=(current().get("account") or {}).get("active")))
    elif cmd == "run":   # a long command outside the session, up to 24 h: the result comes as a message (core/hubrun.py)
        run_command(rest)
    elif cmd == "restart" and "--cancel" in rest:
        put("hub.restart_cancelled", None, {})
    elif cmd == "restart":
        words = [w for w in rest if w != "--now"]
        # the leading words that are parts are the parts. Text after them is an explanation only when a part is
        # prefixed (ext:/mod:): `web is stuck` or `update the schedule` is still a whole-hub restart with that reason,
        # since a bare part name is an ordinary word too. Words that open with the reason are all the reason.
        cut = 0
        while cut < len(words) and (words[cut] in restart.PARTS + ("hubd",) or words[cut].startswith(("ext:", "mod:"))):
            cut += 1
        if cut < len(words) and not any(w.startswith(("ext:", "mod:")) for w in words[:cut]):
            cut = 0
        parts, words = words[:cut], words[cut:]
        if parts:   # a plugin by its key from settings, case-insensitive; an unknown one is refused, not "accepted" and silence
            from core import catalog
            try:
                exts = catalog.load_config(STATE).get("extensions") or {}
            except ValueError:
                exts = None
            # a plugin removed from settings but still running is a part too: hub-up stops it and does not start it
            live = (restart.find_up(STATE, platforms.current.restart_gap()).get("exts") or {}) if exts is not None else {}
            parts, unknown = restart.ext_parts(parts, exts, live)
            if unknown:
                from core import i18n
                sys.exit(i18n.t("cli.restart.unknown_part", parts=", ".join(unknown),
                                plugins=", ".join(dict.fromkeys([f"ext:{k}" for k in exts] + list(live))) or i18n.t("cli.restart.no_plugins")))
        asked = time.time()
        seq = put("hub.restart_requested", None, {"parts": parts, "now": "--now" in rest,
                                                  "why": None if parts else " ".join(words) or None})
        if not parts and seq and seq not in REJECTED:   # the earlier Linux service layout: the installer carries it out (core/oldlayout)
            from core import oldlayout
            said = oldlayout.on_restart(STATE, asked)
            if said:
                print(said)
    elif cmd in ("on", "off") and not rest:
        service_cmd(cmd)
    elif cmd in ("ui", "open") and rest in ([], ["--print"]):
        service_cmd(cmd, printing=bool(rest))
    elif cmd == "password" and rest in ([], ["set"], ["off"]):
        password_cmd(rest[0] if rest else None)
    elif cmd == "stop" and not rest:
        if ME or OUTSIDER:  # a plugin or module process is not the owner: a full restart is closed to it too
            sys.exit(i18n.t("cli.stop.owner_terminal"))

        up = restart.find_up(STATE, platforms.current.restart_gap())   # hub-up writes about itself at start (restart.UP)
        if not up:   # the hub is already down (killed): the marker is still set, because the owner wants the scheduler's retry not to bring it up
            if os.path.isdir(STATE):
                with open(os.path.join(STATE, restart.HELD), "w") as f:
                    f.write("")
            sys.exit(i18n.t("cli.stop.up_not_running"))
        if up.get("service"):  # review: launchd KeepAlive used to bring the hub up again after ~10 s
            sys.exit(i18n.t("cli.stop.held_by_service", service=up['service']))
        restart.ask_stop(STATE)
        print(i18n.t("cli.stop.stopping"))
    elif cmd == "close-ready" and ME:
        put("session.close_ready", ME, {"summary": " ".join(text_words(rest)) or None})
    elif cmd in ("delegate", "delegations", "delegation"):
        # a delegation and a task are the same thing (dN); one name remains (owner decision 2026-10-05: "task")
        sys.exit(i18n.t("cli.delegate.now_tasks"))
    elif cmd == "task" and rest[:1] == ["new"] and len(rest) >= 3:
        # a task (dN; spec "tasks, specialists, executors"): any session can set it, the result goes to it; with --for mN,
        # by the owner's words (sent verbatim, the result goes to the owner under their message, REPLIED to the hub),
        # --for-session S sends the result to session S
        target, (pin, words) = rest[1], pin_flags([w for w in rest[2:] if w != "--now"])
        opts = {}
        for flag in ("--for", "--for-session", "--card"):   # --card qN: their words are an answer to this session card
            opts[flag], words = value_of(words, flag)
        brief = " ".join(text_words(words))   # all of it is the setter's words: `lead` is how the page tells them from the core's frame
        busy_note(put("delegation.created", None, {"session": target, "for": opts.get("--for"),
                                                   "for_session": opts.get("--for-session") or (None if opts.get("--for") else ME),
                                                   **({"card": opts["--card"]} if opts.get("--card") else {}),
                                                   "context": brief, "lead": len(brief), **pin,
                                                   **({"now": True} if "--now" in rest[2:] else {})}))
    elif cmd == "route" and len(rest) >= 2 and rest[1] in ("queue", "executor", "drop", "now"):
        # a message to a busy specialist is decided by the hub (owner decision 2026-10-05)
        if rest[1] == "drop" and len(rest) < 3:
            sys.exit(i18n.t("cli.route.drop_usage"))
        name = value_of(rest[2:], "--name")[0] if rest[1] == "executor" else None
        # the model of task dN may have been set already at hub task new
        pin = pin_flags(rest[2:], need=True, task=lambda: routed_task(current(), rest[0]))[0] if rest[1] == "executor" else {}
        put("message.routed", rest[0], {"route": rest[1], **({"why": " ".join(rest[2:])} if rest[1] == "drop" else {}),
                                        **({"name": name} if name else {}), **pin})
    elif cmd == "task" and rest[:1] == ["run"] and len(rest) >= 3:
        name, (pin, words) = rest[1], pin_flags(rest[2:], need=True)
        repo, words = value_of(words, "--repo")
        repo = repo and os.path.abspath(os.path.expanduser(repo))
        # hub: the owner's word (mN, or qN for their answer) lifts the weekly limit threshold
        src, words = value_of(words, "--for")
        # tools at start: those granted after it starts it will see only after a turn
        kit, words = value_of(words, "--tools")
        kit = kit and [t for t in kit.split(",") if t.strip()]
        # on an existing branch; --here works right in the ready copy of --repo (slice 3)
        branch, words = value_of(words, "--branch")
        # --from-main: its own branch from the repo's main branch (main, from origin if the local one is behind), not from the folder's HEAD
        here, from_main = "--here" in words, "--from-main" in words
        # --spec [--spec-dir NAME]: an executor in spec mode, its spec in specs/<NAME or dN>/spec.md (core/specmode.py)
        spec_dir, words = value_of(words, "--spec-dir")
        spec = spec_dir or "--spec" in words
        words = [w for w in words if w not in ("--here", "--from-main", "--spec")]
        if not repo and not here:   # a direction comes up in a copy of its own repo (on --branch too: the branch is there)
            repo = direction_repo(name)
        # the direction board card the work is for (core/board.py): --board TASK-N or TASK-N on the first line
        card, words = value_of(words, "--board")
        words = text_words(words)
        link, slug = board_link(card, " ".join(words))
        seq = put("task.run_requested", name, {"task": " ".join(words), **({"repo": repo} if repo else {}),
                                               **({"board": link} if link else {}),
                                               **({"branch": branch} if branch else {}), **({"here": True} if here else {}),
                                               **({"from_main": True} if from_main else {}),
                                               **({"spec": spec} if spec else {}),
                                               **({"for": src} if src else {}), **({"tools": kit} if kit else {}),
                                               **pin})
        run = (current().get("runs") or {}).get(name) if seq and seq not in REJECTED else None
        if slug and not link and seq not in REJECTED:
            from core import board
            print(board.NO_CARD.format(slug=slug))
        if run and run.get("state") == "queued":   # not a refusal but a queue (owner decision 2026-10-04): shows why it waits
            from core import budget, executors
            st = current()
            mine = st["sessions"].get(ME or "")
            held = executors.budget_waits(st, run.get("owner_ok"), time.time(), run.get("live"))
            # nothing is written to the hub about a mini-hub's slot or, for everyone, about limit saving (that goes in the owner's card)
            untold = minihub.on(st, mine) and not held or held and budget.mode(st)
            from core import coretext
            why = coretext.human(coretext.got(run, "why"))   # the core's phrases: in the language of whoever reads
            print(i18n.t("cli.task.run_queued", pos=executors.position(st, name), why=why, name=name) if untold else
                  i18n.t("cli.task.run_queued_hub", pos=executors.position(st, name), why=why, name=name))
    elif cmd == "task" and rest[:1] == ["go"] and "--queue" in rest[1:2]:
        # the limit-saving card button: the owner's word for the whole queue (or only normal), slots follow the ceilings
        src = value_of(rest[2:], "--for")[0]
        only = "normal" in rest[2:3]
        st = current()
        names = [n for n, r in sorted((st.get("runs") or {}).items(), key=lambda kv: kv[1].get("ts") or 0)
                 if r.get("state") == "queued" and (not only or r.get("work") == "normal")]
        # the owner's word for a leading session works only for its own executors: the rest are refused, not "waiting for a slot"
        refused = [n for n in names if put("task.run_go", n, {"queue": True, **({"for": src} if src else {})})
                   in REJECTED]
        st = current()
        up = [n for n in names if (st.get("runs") or {}).get(n, {}).get("state") != "queued"]
        tail = i18n.t("cli.task.go_refused", count=len(refused), names=", ".join(refused)) if refused else ""
        print(i18n.t("cli.task.go_queue", n=len(names), only=i18n.t("cli.task.go_only_normal") if only else "",
                     up=len(up), waiting=len(names) - len(up) - len(refused), tail=tail)
              if names else i18n.t("cli.task.go_queue_none"))
    elif cmd == "task" and rest[:1] in (["go"], ["cancel"]) and len(rest) >= 2:
