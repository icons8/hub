#!/usr/bin/env python3
"""Journal watchdog: a process under hub-up that watches the journal live and reports trouble to the hub (modules/watch/watch.py)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
import platforms  # noqa: E402
platforms.current.utf8_mode([os.path.realpath(__file__)] + sys.argv[1:])   # output and files are UTF-8 under any locale
from modules.watch.watch import main  # noqa: E402

main()
