   "entity": "hub",
   "data": {
    "session_id": "sid-hub"
   }
  },
  {
   "t": 0,
   "type": "session.requested",
   "entity": "w",
   "data": {
    "cwd": "/w",
    "session_id": "sid-w"
   }
  },
  {
   "t": 1,
   "type": "session.started",
   "entity": "w",
   "data": {
    "session_id": "sid-w"
   }
  },
  {
